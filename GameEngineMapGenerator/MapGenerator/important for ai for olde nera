    # --- Content Pool Handling ---

    def _add_content_pool_item(self, pool_type: str) -> None:
        """Add an item to the specified content pool."""
        if not self.current_zone:
            return

        # Get available content pools from data manager
        available_pools = self.data_manager.get_content_pool_names()
        if not available_pools:
            available_pools = [
                "content_pool_default_guarded",
                "content_pool_default_unguarded",
                "content_pool_default_resources",
            ]

        text, ok = QInputDialog.getItem(
            self,
            f"Add {pool_type.title()} Content Pool",
            "Select content pool:",
            available_pools,
            0,
            True,
        )

        if ok and text.strip():
            content_pool = text.strip()

            if pool_type == "guarded":
                if content_pool not in self.current_zone.guarded_content_pool:
                    self.current_zone.guarded_content_pool.append(content_pool)
            elif pool_type == "unguarded":
                if content_pool not in self.current_zone.unguarded_content_pool:
                    self.current_zone.unguarded_content_pool.append(content_pool)
            elif pool_type == "resources":
                if content_pool not in self.current_zone.resources_content_pool:
                    self.current_zone.resources_content_pool.append(content_pool)

            # Refresh the integrated content display
            pool_name = self.content_pool_search.currentText()
            current_pool_type = self._get_current_pool_type()
            if current_pool_type:
                self._load_pool_items(pool_name, current_pool_type)
            self.zone_changed.emit()

    def _remove_content_pool_item(self, pool_type: str) -> None:
        """Remove selected item from the specified content pool."""
        if not self.current_zone:
            return

        selected_items = self.pool_items_list.selectedItems()
        if not selected_items:
            return

        # Get the pool list based on type
        pool_list = None
        if pool_type == "guarded":
            pool_list = self.current_zone.guarded_content_pool
        elif pool_type == "unguarded":
            pool_list = self.current_zone.unguarded_content_pool
        elif pool_type == "resources":
            pool_list = self.current_zone.resources_content_pool

        if pool_list:
            # Remove selected items
            for item in selected_items:
                content_pool = item.text()
                if content_pool in pool_list:
                    pool_list.remove(content_pool)

            # Refresh the integrated content display
            pool_name = self.content_pool_search.currentText()
            current_pool_type = self._get_current_pool_type()
            if current_pool_type:
                self._load_pool_items(pool_name, current_pool_type)
            self.zone_changed.emit()

