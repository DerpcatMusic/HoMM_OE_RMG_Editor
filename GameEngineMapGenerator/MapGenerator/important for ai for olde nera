        self.current_zone.crossroads_position = self.crossroads_position_spin.value()
        self.zone_changed.emit()

    def _add_to_current_pool(self):
        """Add items to the currently selected pool."""
        # Get current pool selection from regular combo box
        current_text = self.content_pool_search.currentText()
        if current_text:
            pool_type = self._determine_pool_type(current_text)
            self._add_content_pool_item(pool_type.lower())

    def _remove_from_current_pool(self):
        """Remove selected items from the current pool."""
        selected_items = self.pool_items_list.selectedItems()
        if not selected_items:
            return

        # Get current pool type
        pool_type = self._get_current_pool_type()
        if pool_type:
            self._remove_content_pool_item(pool_type.lower())

    def _clear_current_pool(self):
        """Clear all items from the current pool."""
        from PySide6.QtWidgets import QMessageBox

        reply = QMessageBox.question(
            self,
            "Clear Pool",
            "Are you sure you want to clear all items from this content pool?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
        )

        if reply == QMessageBox.StandardButton.Yes:
            pool_type = self._get_current_pool_type()
            if pool_type and self.current_zone:
                if pool_type.lower() == "guarded":
                    self.current_zone.guarded_content_pool.clear()
                elif pool_type.lower() == "unguarded":
                    self.current_zone.unguarded_content_pool.clear()
                elif pool_type.lower() == "resources":
                    self.current_zone.resources_content_pool.clear()

                # Refresh display
                pool_name = self.content_pool_search.currentText()
                self._load_pool_items(pool_name, pool_type)
                self.zone_changed.emit()

    def _on_pool_item_selection_changed(self):
        """Handle pool item selection changes."""
        has_selection = len(self.pool_items_list.selectedItems()) > 0
        self.remove_from_pool_btn.setEnabled(has_selection)

    def _get_current_pool_type(self) -> str | None:
        """Get the type of the currently selected pool."""
        current_text = self.content_pool_search.currentText()
        if current_text:
            return self._determine_pool_type(current_text)
        return None

