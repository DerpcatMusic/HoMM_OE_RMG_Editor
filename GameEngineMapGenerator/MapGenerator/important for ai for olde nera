    def _remove_placement_arg(self):
        """Remove selected placement argument."""
        current_row = self.placement_args_list.currentRow()
        if current_row >= 0:
            self.placement_args_list.takeItem(current_row)
            self._on_data_changed()

    def _clear_placement_args(self):
