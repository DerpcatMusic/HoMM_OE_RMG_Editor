    def load_zone(self, zone: Zone) -> None:
        """Load a zone into the widget for editing."""
        self.current_zone = zone
        self.setEnabled(True)
        self._updating = True

        try:
            # Load basic properties
            self.zone_name_edit.setText(zone.name)
            self.zone_size_spin.setValue(zone.size)
            self.zone_layout_combo.setCurrentText(zone.layout)
            self._on_zone_layout_changed_preview()
            self.crossroads_position_spin.setValue(zone.crossroads_position)

            # Load biome rules into UI with error handling
            try:
                if hasattr(zone, "zone_biome") and zone.zone_biome:
                    self._load_biome_rule_to_ui("zone", zone.zone_biome)
            except Exception as e:
                logging.warning(f"Failed to load zone biome rule: {e}")

            try:
                if hasattr(zone, "content_biome") and zone.content_biome:
                    self._load_biome_rule_to_ui("content", zone.content_biome)
            except Exception as e:
                logging.warning(f"Failed to load content biome rule: {e}")

            try:
                if hasattr(zone, "meta_objects_biome") and zone.meta_objects_biome:
                    self._load_biome_rule_to_ui("meta_objects", zone.meta_objects_biome)
            except Exception as e:
                logging.warning(f"Failed to load meta objects biome rule: {e}")

            # Load content values will be handled by the integrated system when pools are selected
            # Values are loaded dynamically when a pool is selected in the integrated view

            # Load guard settings
            self.diplomacy_modifier_spin.setValue(zone.diplomacy_modifier)
            self.guard_cutoff_value_spin.setValue(zone.guard_cutoff_value)
            self.guard_multiplier_spin.setValue(zone.guard_multiplier)
            self.guard_randomization_spin.setValue(zone.guard_randomization)
            self.guard_weekly_increment_spin.setValue(zone.guard_weekly_increment)

            # Load guard reaction distribution
            if zone.guard_reaction_distribution and len(zone.guard_reaction_distribution) >= len(self.reaction_spins):
                for i, value in enumerate(zone.guard_reaction_distribution):
                    if i < len(self.reaction_spins):
                        self.reaction_spins[i].setValue(value)

            # Load misc settings
            self.random_hire_weekly_check.setChecked(zone.random_hire_enable_weekly_unit_increment)
            self.random_hire_initial_spin.setValue(zone.random_hire_initial_unit_increment)

            # Load encounter holes settings
            if hasattr(zone, "encounter_holes_settings") and zone.encounter_holes_settings is not None:
                settings = zone.encounter_holes_settings
                self.holes_affected_encounters_spin.setValue(getattr(settings, "affected_encounters", 0.5))
                self.holes_two_hole_encounters_spin.setValue(getattr(settings, "two_hole_encounters", 0.25))
            else:
                # Set defaults if encounter_holes_settings is None or doesn't exist
                self.holes_affected_encounters_spin.setValue(0.5)
                self.holes_two_hole_encounters_spin.setValue(0.25)

            # Refresh all lists
            self._refresh_content_count_limits()
            self._refresh_roads_list()
            self._refresh_main_objects_list()
            self._refresh_mandatory_content_list()
            self._update_biome_object_combos()

            # Refresh integrated content management
            self._populate_content_pool_search()

        finally:
            self._updating = False

