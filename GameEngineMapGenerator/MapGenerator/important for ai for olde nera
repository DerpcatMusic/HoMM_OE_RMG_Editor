                                width=template_data.get("width", 3),
                                height=template_data.get("height", 3),
                                mount_offset=tuple(template_data.get("mountOffset", [0, 0])),
                                entrances=[tuple(e) for e in template_data.get("entrances", [])],
                                buildings=template_data.get("buildings", []),
                                pickups=[tuple(p) for p in template_data.get("pickups", [])],
                                guards=template_data.get("guards", []),
                                tile_contents=template_data.get("tileContents", {}),
                                allow_mirror_x=template_data.get("allowMirrorX", True),
                                allow_mirror_y=template_data.get("allowMirrorY", True),
