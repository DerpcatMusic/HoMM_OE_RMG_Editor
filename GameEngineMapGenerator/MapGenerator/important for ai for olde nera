                # Load RMG-specific data
                self.loading_progress.emit("Loading map templates...", int((2 / total_steps) * 100))
                self.map_templates = self._load_map_templates()

                self.loading_progress.emit("Loading content pools...", int((3 / total_steps) * 100))
