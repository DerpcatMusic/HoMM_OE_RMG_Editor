    def get_connections_for_zone(self, zone_name: str) -> list:
        """Get all connections for a specific zone from the current map data."""
        if not self.current_map or not self.current_map.variants:
            return []

        connections = []
        variant = self.current_map.variants[0]
        for conn in variant.connections:
            if conn.from_zone == zone_name or conn.to_zone == zone_name:
                connections.append(conn)
        return connections

    def add_connection(self, connection_data: dict):
        """Add a connection to the current map data."""
        if not self.current_map or not self.current_map.variants:
            logging.warning("Cannot add connection: no current map data.")
            return

        new_conn = Connection.from_dict(connection_data)
        self.current_map.variants[0].connections.append(new_conn)
        logging.debug(f"Added connection: {new_conn.from_zone} -> {new_conn.to_zone}")

    def remove_connection(self, connection: Connection):
        """Remove a connection from the current map data."""
        if not self.current_map or not self.current_map.variants:
            logging.warning("Cannot remove connection: no current map data.")
            return

        try:
            # Find the actual connection object in the list to remove it
            # This is necessary because the passed object might be a copy
            for conn_in_list in self.current_map.variants[0].connections:
                if (
                    conn_in_list.from_zone == connection.from_zone
                    and conn_in_list.to_zone == connection.to_zone
                    and conn_in_list.connection_type == connection.connection_type
                ):
                    self.current_map.variants[0].connections.remove(conn_in_list)
                    logging.debug(f"Removed connection: {connection.from_zone} -> {connection.to_zone}")
                    return
            # If loop finishes without returning, the connection was not found
            raise ValueError("Connection not found in list")
        except ValueError:
            logging.warning(f"Attempted to remove a connection that does not exist: {connection}")
"""
Content Database for RMG Editor

Provides comprehensive loading and management of external game configuration data,
equivalent to the C# ContentDatabase. This module loads all game data from the
StreamingAssets directory and provides unified lookup functionality.

This implementation follows Python best practices for data processing with
NumPy/Pandas optimization where applicable and robust error handling.
"""

