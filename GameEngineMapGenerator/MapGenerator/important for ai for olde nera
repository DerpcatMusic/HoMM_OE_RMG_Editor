                self.logger.error(f"Failed to load encounter templates: {e}")

    def _load_zone_layouts(self):
        """Load zone layout configurations from a directory of JSON files."""
        layouts_dir = self.streaming_assets_path / "Config" / "zone_layouts"

        if layouts_dir.exists() and layouts_dir.is_dir():
            try:
                for layout_file in layouts_dir.glob("*.json"):
                    with open(layout_file, encoding="utf-8") as f:
                        data = json.load(f)

                    # A single file can contain one layout object or a list of them
                    layout_data_list = data if isinstance(data, list) else [data]

                    for layout_data in layout_data_list:
                        if isinstance(layout_data, dict) and "name" in layout_data:
                            # Use Pydantic model from models.py
                            try:
                                layout = ZoneLayoutConfig.model_validate(layout_data)
                                self.zone_layouts[layout.name] = layout
                            except Exception as e:
                                self.logger.warning(
                                    f"Failed to create ZoneLayoutConfig from {layout_data.get('name', 'unknown')}: {e}"
                                )
                                # Fallback to create with available fields
                                layout = ZoneLayoutConfig(name=layout_data["name"])
                                self.zone_layouts[layout.name] = layout
                        else:
                            self.logger.warning(f"Skipping invalid zone layout data in {layout_file.name}")

                self.logger.info(f"Loaded {len(self.zone_layouts)} zone layouts")

            except Exception as e:
                self.logger.error(f"Failed to load zone layouts from {layouts_dir}: {e}", exc_info=True)

