def get_other_zone_names(current_variant, current_zone_name: str) -> list[str]:
    """
    Get list of other zone names for MatchZone dropdown.

    Args:
        current_variant: The Variant object or dict containing zones
        current_zone_name: Name of the zone currently being edited

    Returns:
        List of zone names, with special "<Any (Becomes a Random Template)>" option first
    """
    zone_names = ["<Any (Becomes a Random Template)>"]

    zones = None
    if current_variant:
        # Handle both Variant objects and dict structures
        if hasattr(current_variant, "zones"):
            zones = current_variant.zones
        elif isinstance(current_variant, dict) and "zones" in current_variant:
            zones = current_variant["zones"]
        elif isinstance(current_variant, list):
