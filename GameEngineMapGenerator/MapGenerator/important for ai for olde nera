    def save_content_pool(self, pool_name: str, pool_data: dict[str, Any]) -> bool:
        """Saves a custom content pool to a file."""
        if not self.base_path:
            return False

        # Ensure the custom directory exists
        custom_pools_dir = self.base_path / "StreamingAssets" / "Core" / "generator" / "content_pools" / "_custom"
        custom_pools_dir.mkdir(parents=True, exist_ok=True)

        file_path = custom_pools_dir / f"{pool_name}.json"

        try:
            with file_path.open("w", encoding="utf-8") as f:
                json.dump(pool_data, f, indent=2, ensure_ascii=False)

            # Update the in-memory cache
            self.content_pools[pool_name] = pool_data
            self._organize_content_data()  # Re-organize to include the new pool
            self.data_changed.emit()
            logging.info(f"Successfully saved custom content pool: {file_path}")
            return True
        except Exception as e:
            logging.error(f"Failed to save custom content pool '{pool_name}': {e}")
            return False

