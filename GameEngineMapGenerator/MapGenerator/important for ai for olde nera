def parse_different_from_arg(arg: str) -> tuple[str | None, str | None]:
    """
    Parse a "differentFrom:" argument to extract the target reference.

    Args:
        arg: Argument string like "differentFrom: 1 Spawn-A" or "differentFrom: Spawn-B"

    Returns:
        Tuple of (object_index, zone_name). For zone-only references, object_index is None.
    """
    if not arg.startswith("differentFrom:"):
        return None, None

    # Remove the prefix and strip whitespace
    content = arg[len("differentFrom:") :].strip()
    parts = content.split()

    if len(parts) == 1:
        # Zone-only reference like "differentFrom: Spawn-B"
        return None, parts[0]
    elif len(parts) == 2:
        # Object + Zone reference like "differentFrom: 1 Spawn-A"
        try:
            object_index = parts[0]
            zone_name = parts[1]
            return object_index, zone_name
        except ValueError:
            return None, None

    return None, None


