class FactionRuleWidget(QWidget):
    """Widget for configuring faction rules."""

    dataChanged = Signal()

    def __init__(self, data_manager=None, parent=None):
        super().__init__(parent)
        self.faction_rule: FactionRule | None = None
        self.data_manager = data_manager
        logger.info(f"FactionRuleWidget initialized with data_manager: {data_manager is not None}")
        self._setup_ui()

    def _setup_ui(self):
        """Setup the faction rule UI."""
        layout = QVBoxLayout(self)

        # Title
        title = StrongBodyLabel("Faction Configuration", self)
        title.setFont(QFont("", 10, QFont.Weight.Bold))
        layout.addWidget(title)

        # Rule type
        form_layout = QFormLayout()
        form_layout.setContentsMargins(0, 10, 0, 0)

        self.type_combo = ComboBox()
        # Use actual FactionRuleType enum values
        for rule_type in FactionRuleType:
            self.type_combo.addItem(rule_type.value, rule_type)
        form_layout.addRow("Rule Type:", self.type_combo)

        layout.addLayout(form_layout)

        # Arguments container that will change based on rule type
        self.args_container = QWidget()
        self.args_layout = QVBoxLayout(self.args_container)
        layout.addWidget(self.args_container)

        # Initialize with default arguments widget
        self._setup_arguments_widget()

        # Connect signals
        self.type_combo.currentTextChanged.connect(self._on_rule_type_changed)

    def showEvent(self, event):
        """Handle widget show event to refresh biomes if needed."""
        super().showEvent(event)
        # Refresh biomes when the widget becomes visible
        if hasattr(self, "biome_list") and self.biome_list and self.biome_list.count() == 0:
            logger.info("=== FactionRuleWidget: Widget shown, refreshing empty biome list ===")
            self.refresh_biomes()

    def _on_rule_type_changed(self):
        """Handle rule type change."""
        current_type = self.type_combo.currentText()
        logger.info(f"Faction rule type changed to: {current_type}")
        self._setup_arguments_widget()
        self.dataChanged.emit()

    def _setup_arguments_widget(self):
        """Setup the arguments widget based on the current rule type."""
        # Clear existing arguments widget
        for i in reversed(range(self.args_layout.count())):
            child = self.args_layout.itemAt(i).widget()
            if child:
                child.setParent(None)

        current_rule_type = self.type_combo.currentData()
        if not current_rule_type:
            current_rule_type = FactionRuleType.FROM_LIST

        if current_rule_type == FactionRuleType.FROM_LIST:
            logger.info("Creating FromList widget for faction rule")
            self._create_from_list_widget()
        elif current_rule_type == FactionRuleType.MATCH:
            logger.info("Creating Match widget for faction rule")
            self._create_match_widget()
        else:
            logger.info("Creating generic widget for faction rule")
            self._create_generic_widget()

    def _create_from_list_widget(self):
        """Create widget for FromList rule type - shows biome selection."""
        label = BodyLabel("Select biomes to choose from:")
        self.args_layout.addWidget(label)

        self.biome_list = ListWidget()
        self.biome_list.setMaximumHeight(120)
        self.biome_list.setSelectionMode(ListWidget.SelectionMode.MultiSelection)

        # Load biomes lazily when widget is shown
        self._load_biomes_for_list()

        self.biome_list.itemChanged.connect(lambda: self.dataChanged.emit())
        self.args_layout.addWidget(self.biome_list)

        # Add debug refresh button
        refresh_btn = PushButton("Refresh Biomes")
        refresh_btn.clicked.connect(self.refresh_biomes)
        self.args_layout.addWidget(refresh_btn)

    def _create_match_widget(self):
        """Create widget for Match rule type - shows main object index input."""
        label = BodyLabel("Main object index to match faction from:")
        self.args_layout.addWidget(label)

        self.match_index_spin = SpinBox()
        self.match_index_spin.setRange(0, 99)
        self.match_index_spin.setValue(0)
        self.match_index_spin.valueChanged.connect(lambda: self.dataChanged.emit())
        self.args_layout.addWidget(self.match_index_spin)

    def _create_generic_widget(self):
        """Create generic argument widget for other rule types."""
        label = BodyLabel("Arguments:")
        self.args_layout.addWidget(label)

        self.args_list = ListWidget()
        self.args_list.setMaximumHeight(100)
        self.args_layout.addWidget(self.args_list)

        # Add/Remove buttons
        args_buttons = QHBoxLayout()
        self.add_arg_button = PrimaryPushButton("Add Argument")
        self.remove_arg_button = PushButton("Remove Selected")
        args_buttons.addWidget(self.add_arg_button)
        args_buttons.addWidget(self.remove_arg_button)
        self.args_layout.addLayout(args_buttons)

        self.add_arg_button.clicked.connect(self._add_argument)
        self.remove_arg_button.clicked.connect(self._remove_argument)

    def _add_argument(self):
        """Add a new argument."""
        text, ok = QInputDialog.getText(self, "Add Argument", "Enter argument:")
        if ok and text.strip():
            item = ListWidgetItem(text.strip())
            self.args_list.addItem(item)
            self.dataChanged.emit()

    def _remove_argument(self):
        """Remove selected argument."""
        if hasattr(self, "args_list"):
            current_row = self.args_list.currentRow()
            if current_row >= 0:
                self.args_list.takeItem(current_row)
                self.dataChanged.emit()

    def set_faction_rule(self, faction_rule: FactionRule):
        """Set the faction rule to edit."""
        self.faction_rule = faction_rule

        if faction_rule.type:
            # First try to find by data (enum value)
            for i in range(self.type_combo.count()):
                if self.type_combo.itemData(i) == faction_rule.type:
                    self.type_combo.setCurrentIndex(i)
                    break
            else:
                # Fallback to text search
                type_text = faction_rule.type.value if hasattr(faction_rule.type, "value") else str(faction_rule.type)
                index = self.type_combo.findText(type_text)
                if index >= 0:
                    self.type_combo.setCurrentIndex(index)

        # Setup the appropriate widget for the rule type
        self._setup_arguments_widget()

        # Update arguments based on rule type
        self._set_arguments_from_rule(faction_rule)

    def _set_arguments_from_rule(self, faction_rule: FactionRule):
        """Set arguments in the UI based on the faction rule."""
        if not faction_rule.args:
            return

        current_rule_type = self.type_combo.currentData()
        if not current_rule_type:
            current_rule_type = FactionRuleType.FROM_LIST

        if current_rule_type == FactionRuleType.FROM_LIST:
            # Set selected biomes
            if hasattr(self, "biome_list"):
                for i in range(self.biome_list.count()):
                    item = self.biome_list.item(i)
                    if item.text() in faction_rule.args:
                        item.setCheckState(Qt.CheckState.Checked)
        elif current_rule_type == FactionRuleType.MATCH:
            # Set main object index
            if hasattr(self, "match_index_spin") and faction_rule.args:
                try:
                    index = int(faction_rule.args[0])
                    self.match_index_spin.setValue(index)
                except (ValueError, IndexError):
                    pass
        else:
            # Generic arguments list
            if hasattr(self, "args_list"):
                self.args_list.clear()
                for arg in faction_rule.args:
                    item = ListWidgetItem(str(arg))
                    self.args_list.addItem(item)

    def get_faction_rule(self) -> FactionRule:
        """Get the current faction rule from UI."""
        if not self.faction_rule:
            self.faction_rule = FactionRule()

        # Get the enum value from combo box data or text
        current_data = self.type_combo.currentData()
        if current_data and isinstance(current_data, FactionRuleType):
            self.faction_rule.type = current_data
        else:
            # Fallback to text-based lookup
            current_text = self.type_combo.currentText()
            try:
                self.faction_rule.type = FactionRuleType(current_text)
            except ValueError:
                # Default fallback
                self.faction_rule.type = FactionRuleType.FROM_LIST

        # Get arguments based on rule type
        args = []
        current_rule_type = self.faction_rule.type

        if current_rule_type == FactionRuleType.FROM_LIST:
            # Get selected biomes
            if hasattr(self, "biome_list"):
                for i in range(self.biome_list.count()):
                    item = self.biome_list.item(i)
                    if item.checkState() == Qt.CheckState.Checked:
                        args.append(item.text())
        elif current_rule_type == FactionRuleType.MATCH:
            # Get main object index
            if hasattr(self, "match_index_spin"):
                args.append(str(self.match_index_spin.value()))
        else:
            # Generic arguments list
            if hasattr(self, "args_list"):
                for i in range(self.args_list.count()):
                    item = self.args_list.item(i)
                    args.append(item.text())

        self.faction_rule.args = args
        return self.faction_rule

    def _load_biomes_for_list(self):
        """Load biomes into the biome list widget."""
        # Clear existing items first
        self.biome_list.clear()

        # Debug data manager state
        logger.info("=== FactionRuleWidget: Data manager state ===")
        logger.info(f"Data manager exists: {self.data_manager is not None}")
        if self.data_manager:
            logger.info(f"Data manager type: {type(self.data_manager)}")
            logger.info(f"Has get_available_biomes: {hasattr(self.data_manager, 'get_available_biomes')}")
            logger.info(
                f"Content database exists: {hasattr(self.data_manager, 'content_database') and self.data_manager.content_database is not None}"
            )
            if hasattr(self.data_manager, "content_database") and self.data_manager.content_database:
                logger.info(f"Content database loaded: {self.data_manager.content_database.is_loaded}")

        biomes = self._get_available_biomes()
        logger.info(f"=== FactionRuleWidget: Loading {len(biomes)} biomes for faction widget ===")

        if not biomes:
            logger.error("No biomes returned from _get_available_biomes!")
            # Emergency fallback
            biomes = ["Grass", "Dirt", "Sand"]

        for biome in biomes:
            item = ListWidgetItem(biome)
            item.setCheckState(Qt.CheckState.Unchecked)
            self.biome_list.addItem(item)

        logger.info(f"=== FactionRuleWidget: Successfully loaded {self.biome_list.count()} biome items ===")

    def _get_available_biomes(self) -> list:
        """Get available biomes using data manager or fallback to game data."""
        logger.info("=== FactionRuleWidget: Getting available biomes ===")

        # Always return biomes - first try data manager, then fallbacks
        biomes = []

        try:
            # First try data manager
            if self.data_manager:
                logger.info("Trying data manager...")
                if hasattr(self.data_manager, "get_available_biomes"):
                    biomes = self.data_manager.get_available_biomes()
                    logger.info(f"Data manager returned {len(biomes) if biomes else 0} biomes: {biomes}")
                    if biomes:
                        return biomes
                else:
                    logger.warning("Data manager does not have get_available_biomes method")
            else:
                logger.warning("No data manager available")

            # Try content database directly if data manager has one
            if self.data_manager and hasattr(self.data_manager, "content_database"):
                logger.info("Trying content database...")
                if self.data_manager.content_database and hasattr(
                    self.data_manager.content_database, "get_biome_names"
                ):
                    biomes = self.data_manager.content_database.get_biome_names()
                    logger.info(f"Content database returned {len(biomes) if biomes else 0} biomes: {biomes}")
                    if biomes:
                        return biomes

            # Fallback to game data loader
            logger.info("Falling back to game data loader for biomes")
            game_data = get_game_data()
            if game_data:
                biomes = game_data.get_biome_sids()
                logger.info(f"Game data loader returned {len(biomes) if biomes else 0} biomes: {biomes}")
                if biomes:
                    return biomes
            else:
                logger.warning("Game data loader returned None")

        except Exception as e:
            logger.error(f"Exception while loading biomes: {e}", exc_info=True)

        # Final fallback to hardcoded biomes using same as zone properties widget
        logger.warning("Using fallback hardcoded biomes")
        fallback_biomes = [
            "Grass",
            "Deathland",
            "Dirt",
            "Lava",
            "Sand",
            "Ice",
            "Autumn",
        ]
        logger.info(f"Returning {len(fallback_biomes)} fallback biomes: {fallback_biomes}")
        return fallback_biomes

    def refresh_biomes(self):
        """Refresh the biome list - useful if data becomes available later."""
        if hasattr(self, "biome_list") and self.biome_list:
            logger.info("=== FactionRuleWidget: Refreshing biomes ===")
            self._load_biomes_for_list()

    def debug_biome_loading(self):
        """Debug method to test biome loading and print detailed info."""
        logger.info("=== DEBUG: Testing biome loading ===")

        # Test data manager
        if self.data_manager:
            logger.info(f"Data manager type: {type(self.data_manager)}")
            logger.info(f"Data manager has get_available_biomes: {hasattr(self.data_manager, 'get_available_biomes')}")

            try:
                biomes = self.data_manager.get_available_biomes()
                logger.info(f"Data manager returned: {biomes}")
                logger.info(f"Biome count: {len(biomes) if biomes else 0}")
                logger.info(f"Biome types: {[type(b) for b in (biomes or [])]}")
            except Exception as e:
                logger.error(f"Error calling get_available_biomes: {e}")
        else:
            logger.info("No data manager available")

        # Test fallback method
        try:
            game_data = get_game_data()
            if game_data:
                fallback_biomes = game_data.get_biome_sids()
                logger.info(f"Game data fallback returned: {fallback_biomes}")
            else:
                logger.info("Game data fallback not available")
        except Exception as e:
            logger.error(f"Error with game data fallback: {e}")

        # Force refresh the list
        if hasattr(self, "biome_list"):
            self._load_biomes_for_list()
            logger.info(f"Biome list widget now has {self.biome_list.count()} items")

        logger.info("=== DEBUG: End biome loading test ===")


