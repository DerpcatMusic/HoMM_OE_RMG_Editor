def get_main_objects_in_zone(zone_name: str, current_variant) -> list[str]:
    """
    Get list of main objects in a specific zone.

    Args:
        zone_name: Name of the zone to query
        current_variant: The Variant object

    Returns:
        List of descriptive strings like ["0: Spawn", "1: City"]
    """
    if not current_variant or not hasattr(current_variant, "zones"):
        return []

    target_zone = None
    for zone in current_variant.zones:
        if zone.name == zone_name:
            target_zone = zone
            break

    if not target_zone:
        return []

    return get_main_object_options(target_zone)


def validate_biome_rule_args(rule_type: str, args: list[str], game_data: GameDataLoader) -> tuple[bool, str]:
    """
    Validate BiomeRule arguments for consistency.

    Args:
        rule_type: Type of the BiomeRule ("FromList", "MatchZone", "MatchMainObject")
        args: Arguments list to validate
        game_data: GameDataLoader instance

    Returns:
        Tuple of (is_valid, error_message)
    """
    if rule_type == "FromList":
        available_biomes = game_data.get_biome_sids()
        for arg in args:
            if not arg.startswith("differentFrom:"):
                if arg not in available_biomes:
                    return (
                        False,
                        f"Unknown biome: {arg}. Available biomes: {available_biomes}",
                    )

    elif rule_type == "MatchZone":
        # Zone validation would need the current variant context
        # For now, just check that we don't have too many args
        if len(args) > 1:
            return False, "MatchZone should have at most 1 argument (zone name)"

    elif rule_type == "MatchMainObject":
        # MainObject validation would need the current zone context
        # For now, just check basic format
        if len(args) > 2:
            return (
                False,
                "MatchMainObject should have at most 2 arguments (object_index, zone_name)",
            )
        if args and not args[0].isdigit():
            return (
                False,
                f"First argument should be object index (number), got: {args[0]}",
            )

    return True, ""


