    def _update_biome_object_combos(self) -> None:
        """Update the biome object combo boxes with current main objects."""
        if not self.current_zone:
            return

        object_options = [""]  # Empty option
        object_display_options = [""]  # Display text options
        for i, obj in enumerate(self.current_zone.main_objects):
            # Handle both enum and string values for obj.type
            type_value = obj.type.value if hasattr(obj.type, "value") else str(obj.type)
            display_text = f"[{i}] {type_value}"
            object_options.append(str(i))  # Store index as value
            object_display_options.append(display_text)  # Store display text

        # Update all biome object combos
        for combo in [
            self.zone_biome_object_combo,
            self.content_biome_object_combo,
            self.meta_objects_biome_object_combo,
        ]:
            current_index = combo.currentData() if hasattr(combo, "currentData") else None
            combo.clear()

            # Add items with data
            for i, (display_text, index_value) in enumerate(zip(object_display_options, object_options)):
                combo.addItem(display_text, index_value)

            # Try to restore previous selection by index value
            if current_index is not None:
                index = combo.findData(current_index)
                if index >= 0:
                    combo.setCurrentIndex(index)

