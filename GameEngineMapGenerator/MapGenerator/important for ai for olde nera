        if self.type_combo:
            self.type_combo.currentTextChanged.connect(self._on_type_changed)
            self.type_combo.currentTextChanged.connect(self._on_rule_changed)

    def _on_type_changed(self, rule_type: str):
        """Handle faction rule type change."""
        # Clear existing args widget
        if self.args_widget:
            self.args_widget.deleteLater()

        # Create new args widget based on type
        self.args_widget = self._create_args_widget(rule_type)
        if self.args_layout:
            self.args_layout.addWidget(self.args_widget)

        # Update preview
        self._update_preview()

    def _create_args_widget(self, rule_type: str) -> QWidget:
        """Create arguments widget for faction rule type."""
        widget = QWidget()
        layout = QVBoxLayout(widget)

        if rule_type == FactionRuleType.FROM_LIST.value:
            self._create_from_list_args(layout)
        elif rule_type == FactionRuleType.MATCH_ZONE.value:
            self._create_match_zone_args(layout)
        elif rule_type == FactionRuleType.MATCH_BIOME.value:
            self._create_match_biome_args(layout)
        else:  # Random or other types
            info_label = QLabel("This rule type requires no additional arguments.")
            info_label.setStyleSheet("color: #666; font-style: italic;")
            layout.addWidget(info_label)

        return widget

