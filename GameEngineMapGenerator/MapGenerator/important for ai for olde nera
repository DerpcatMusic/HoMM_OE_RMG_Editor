    @field_validator("size_x", "size_z")
    @classmethod
    def validate_map_size(cls, v):
        """Validate map size is reasonable."""
        if v < 32:
            raise ValueError(f"Map size must be at least 32, got {v}")
        if v > 512:
            raise ValueError(f"Map size must be at most 512, got {v}")
        return v

    @model_validator(mode="after")
    def validate_template_constraints(self):
        """Validate template constraints based on C# logic."""
        # Must have at least one variant
        if not self.variants:
            raise ValueError("Template must have at least one variant")

        # Each variant should have at least one zone for meaningful maps
        for i, variant in enumerate(self.variants):
            if not variant.zones:
                logger.warning(f"Variant {i} has no zones - map may not generate correctly")

        # Validate zone name uniqueness within each variant
        for i, variant in enumerate(self.variants):
            zone_names = [zone.name for zone in variant.zones if zone.name]
            if len(zone_names) != len(set(zone_names)):
                duplicates = [name for name in zone_names if zone_names.count(name) > 1]
                raise ValueError(f"Variant {i} has duplicate zone names: {duplicates}")

        return self

    def get_all_zones(self) -> list[Zone]:
        """Get all zones from all variants."""
        all_zones = []
        for variant in self.variants:
            all_zones.extend(variant.zones)
        return all_zones

    def get_all_connections(self) -> list[Connection]:
        """Get all connections from all variants."""
        all_connections = []
        for variant in self.variants:
            all_connections.extend(variant.connections)
        return all_connections

    def validate_connections(self) -> list[str]:
        """Validate all connections reference valid zones. Returns list of error messages."""
        errors = []

        for variant_idx, variant in enumerate(self.variants):
            zone_names = {zone.name for zone in variant.zones}

            for conn_idx, connection in enumerate(variant.connections):
                if connection.from_zone not in zone_names:
                    errors.append(
                        f"Variant {variant_idx}, Connection {conn_idx}: 'from_zone' '{connection.from_zone}' does not exist"
                    )

                if connection.to_zone not in zone_names:
                    errors.append(
                        f"Variant {variant_idx}, Connection {conn_idx}: 'to_zone' '{connection.to_zone}' does not exist"
                    )

                if connection.guard_zone and connection.guard_zone not in zone_names:
                    errors.append(
                        f"Variant {variant_idx}, Connection {conn_idx}: 'guard_zone' '{connection.guard_zone}' does not exist"
                    )

        return errors

    def get_content_pool_names(self) -> list[str]:
        """Get list of all content pool names defined in this template."""
        return [pool.name for pool in self.content_pools]

    def get_content_list_names(self) -> list[str]:
        """Get list of all content list names defined in this template."""
        return [list_item.name for list_item in self.content_lists]

    def get_zone_layout_names(self) -> list[str]:
        """Get list of all zone layout names defined in this template."""
        return [layout.name for layout in self.zone_layouts]


