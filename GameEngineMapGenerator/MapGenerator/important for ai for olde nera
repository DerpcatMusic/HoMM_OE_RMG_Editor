    def _generate_preview_text(self, rule: BiomeRule) -> str:
        """Generate human-readable preview text for a biome rule."""
        if not rule or not rule.type:
            return "No rule configured"

        if rule.type == BiomeRuleType.FROM_LIST.value:
            if rule.args:
                biomes = ", ".join(rule.args)
                return f"Randomly select from biomes: {biomes}"
            return "No biomes selected"
        elif rule.type == BiomeRuleType.MATCH_ZONE.value:
            if rule.args:
                return f"Use the same biome as zone: {rule.args[0]}"
            return "No zone specified"
        elif rule.type == BiomeRuleType.MATCH_MAIN_OBJECT.value:
            if rule.args:
                if len(rule.args) > 1:
                    return f"Use biome of main object {rule.args[0]} in zone {rule.args[1]}"
                else:
                    return f"Use biome of main object {rule.args[0]} in same zone"
            return "No main object specified"
        elif rule.type == BiomeRuleType.DIFFERENT_FROM.value:
            if rule.args:
                return f"Use different biome from: {rule.args[0]}"
            return "No reference specified"
        elif rule.type == BiomeRuleType.RANDOM.value:
            return "Use a random biome from all available biomes"
        else:
            return f"Rule type: {rule.type}"

    def get_rule(self) -> BiomeRule:
        """Get the current BiomeRule object."""
        rule = BiomeRule()
        rule.type = self.type_combo.currentText() if self.type_combo else ""
        rule.args = self._get_current_args()
        return rule

    def set_rule(self, rule: BiomeRule):
        """Set the BiomeRule object."""
        if not rule:
            return

        # Set type
        if self.type_combo:
            index = self.type_combo.findText(rule.type)
            if index >= 0:
                self.type_combo.setCurrentIndex(index)

        # Set args (this will trigger _on_type_changed)
        self._set_current_args(rule.args)

    def _get_current_args(self) -> list[str]:
        """Get current arguments based on rule type."""
        if not self.type_combo:
            return []
        rule_type = self.type_combo.currentText()

        if rule_type == BiomeRuleType.FROM_LIST.value:
            return self._get_from_list_args()
        elif rule_type == BiomeRuleType.MATCH_ZONE.value:
            return self._get_match_zone_args()
        elif rule_type == BiomeRuleType.MATCH_MAIN_OBJECT.value:
            return self._get_match_main_object_args()
        elif rule_type == BiomeRuleType.DIFFERENT_FROM.value:
            return self._get_different_from_args()

        return []

    def _get_from_list_args(self) -> list[str]:
        """Get arguments for FromList rule type."""
        if not hasattr(self, "biome_list"):
            return []

        args = []
        for i in range(self.biome_list.count()):
            item = self.biome_list.item(i)
            if item.checkState() == Qt.CheckState.Checked:
                args.append(item.text())
        return args

    def _get_match_zone_args(self) -> list[str]:
        """Get arguments for MatchZone rule type."""
        if not hasattr(self, "zone_combo"):
            return []

        zone_name = self.zone_combo.currentText().strip()
        return [zone_name] if zone_name else []

    def _get_match_main_object_args(self) -> list[str]:
        """Get arguments for MatchMainObject rule type."""
        if not hasattr(self, "main_object_index"):
            return []

        args = [str(self.main_object_index.value())]
        if hasattr(self, "zone_line_edit") and self.zone_line_edit.text().strip():
            args.append(self.zone_line_edit.text().strip())
        return args

    def _get_different_from_args(self) -> list[str]:
        """Get arguments for DifferentFrom rule type."""
        if not hasattr(self, "different_from_edit"):
            return []

        text = self.different_from_edit.text().strip()
        return [text] if text else []

    def _set_current_args(self, args: list[str]):
        """Set current arguments based on rule type."""
        if not args or not self.type_combo:
            return

        rule_type = self.type_combo.currentText()

        if rule_type == BiomeRuleType.FROM_LIST.value:
            self._set_from_list_args(args)
        elif rule_type == BiomeRuleType.MATCH_ZONE.value:
            self._set_match_zone_args(args)
        elif rule_type == BiomeRuleType.MATCH_MAIN_OBJECT.value:
            self._set_match_main_object_args(args)
        elif rule_type == BiomeRuleType.DIFFERENT_FROM.value:
            self._set_different_from_args(args)

    def _set_from_list_args(self, args: list[str]):
        """Set arguments for FromList rule type."""
        if not hasattr(self, "biome_list"):
            return

        # Check items that are in args
        for i in range(self.biome_list.count()):
            item = self.biome_list.item(i)
            if item.text() in args:
                item.setCheckState(Qt.CheckState.Checked)
            else:
                item.setCheckState(Qt.CheckState.Unchecked)

    def _set_match_zone_args(self, args: list[str]):
        """Set arguments for MatchZone rule type."""
        if not hasattr(self, "zone_combo") or not args:
            return

        self.zone_combo.setCurrentText(args[0])

    def _set_match_main_object_args(self, args: list[str]):
        """Set arguments for MatchMainObject rule type."""
        if not hasattr(self, "main_object_index") or not args:
            return

        try:
            self.main_object_index.setValue(int(args[0]))
            if len(args) > 1 and hasattr(self, "zone_line_edit"):
                self.zone_line_edit.setText(args[1])
        except ValueError:
            pass

    def _set_different_from_args(self, args: list[str]):
        """Set arguments for DifferentFrom rule type."""
        if not hasattr(self, "different_from_edit") or not args:
            return

        self.different_from_edit.setText(args[0])

    def validate_rule(self) -> tuple[bool, str]:
        """Validate the current biome rule."""
        rule = self.get_rule()

        if not validate_enum_value(BiomeRuleType, rule.type):
            return False, f"Invalid rule type: {rule.type}"

        if rule.type == BiomeRuleType.FROM_LIST.value:
            if not rule.args:
                return False, "FromList rule requires at least one biome"
            # Validate biome SIDs if data provider available
            if self.data_provider:
                available_biomes = set(self.data_provider.get_available_biomes())
                invalid_biomes = [b for b in rule.args if b not in available_biomes]
                if invalid_biomes:
                    return False, f"Invalid biomes: {', '.join(invalid_biomes)}"

        elif rule.type == BiomeRuleType.MATCH_ZONE.value:
            if not rule.args:
                return False, "MatchZone rule requires a zone name"

        elif rule.type == BiomeRuleType.MATCH_MAIN_OBJECT.value:
            if not rule.args:
                return False, "MatchMainObject rule requires a main object index"
            try:
                int(rule.args[0])
            except (ValueError, IndexError):
                return False, "Main object index must be a number"

        return True, ""


