    def _populate_content_pool_search(self):
        """Populate the content pool search with available pools."""
        # Get available content pools from data manager
        available_pools = []

        try:
            pool_names = self.data_manager.get_content_pool_names() if self.data_manager else []
            for pool_name in pool_names:
                # Determine pool type from name
                pool_type = self._determine_pool_type(pool_name)
                available_pools.append({
                    "name": pool_name,
                    "category": pool_type,
                    "type": pool_type.lower().replace(" ", "_"),
                })
        except Exception as e:
            logging.warning(f"Could not load content pools from data manager: {e}")

        # Add default pools if none found
        if not available_pools:
            default_pools = [
                {
                    "name": "content_pool_default_guarded",
                    "category": "Guarded",
                    "type": "guarded",
                },
                {
                    "name": "content_pool_default_unguarded",
                    "category": "Unguarded",
                    "type": "unguarded",
                },
                {
                    "name": "content_pool_default_resources",
                    "category": "Resources",
                    "type": "resources",
                },
                {
                    "name": "content_pool_treasures_weak",
                    "category": "Guarded",
                    "type": "guarded",
                },
                {
                    "name": "content_pool_treasures_medium",
                    "category": "Guarded",
                    "type": "guarded",
                },
                {
                    "name": "content_pool_treasures_strong",
                    "category": "Guarded",
                    "type": "guarded",
                },
            ]
            available_pools.extend(default_pools)

        # Populate regular combo box
        self.content_pool_search.clear()
        for pool in available_pools:
            self.content_pool_search.addItem(pool["name"], pool)

    def _determine_pool_type(self, pool_name: str) -> str:
        """Determine the type of content pool from its name."""
        name_lower = pool_name.lower()
        if "guarded" in name_lower or "treasure" in name_lower or "artifact" in name_lower:
            return "Guarded"
        elif "unguarded" in name_lower or "pickup" in name_lower:
            return "Unguarded"
        elif "resource" in name_lower or "mine" in name_lower:
            return "Resources"
        else:
            return "Other"

