    def _load_biome_rule_to_ui(self, rule_type: str, biome_rule: BiomeRule) -> None:
        """Load biome rule data into the UI."""
        try:
            if rule_type == "zone":
                type_combo = self.zone_biome_type_combo
                biome_list = self.zone_biome_list
                object_combo = self.zone_biome_object_combo
                different_object_spin = self.zone_biome_different_object_spin
                different_zone_combo = self.zone_biome_different_zone_combo
            elif rule_type == "content":
                type_combo = self.content_biome_type_combo
                biome_list = self.content_biome_list
                object_combo = self.content_biome_object_combo
                different_object_spin = self.content_biome_different_object_spin
                different_zone_combo = self.content_biome_different_zone_combo
            elif rule_type == "meta_objects":
                type_combo = self.meta_objects_biome_type_combo
                biome_list = self.meta_objects_biome_list
                object_combo = self.meta_objects_biome_object_combo
                different_object_spin = self.meta_biome_different_object_spin
                different_zone_combo = self.meta_biome_different_zone_combo
            else:
                return

            # Set rule type - handle both enum and string values
            if hasattr(biome_rule.type, "value"):
                type_value = biome_rule.type.value
            else:
                type_value = str(biome_rule.type)
            type_combo.setCurrentText(type_value)

            # Update visibility based on rule type
            rule_type_str = type_combo.currentText()
            biome_list.setVisible(rule_type_str == BiomeRuleType.FROM_LIST.value)
            object_combo.setVisible(rule_type_str == BiomeRuleType.MATCH_MAIN_OBJECT.value)
            different_object_spin.setVisible(rule_type_str == BiomeRuleType.DIFFERENT_FROM.value)
            different_zone_combo.setVisible(rule_type_str == BiomeRuleType.DIFFERENT_FROM.value)

            # Load args
            if biome_rule.args:
                if rule_type_str == BiomeRuleType.FROM_LIST.value:
                    # Select biomes in the list
                    for i in range(biome_list.count()):
                        item = biome_list.item(i)
                        if item.text() in biome_rule.args:
                            item.setSelected(True)
                elif rule_type_str == BiomeRuleType.MATCH_MAIN_OBJECT.value and biome_rule.args:
                    # Find the combo item by the main object index
                    target_index = biome_rule.args[0]
                    for i in range(object_combo.count()):
                        if object_combo.itemData(i) == target_index:
                            object_combo.setCurrentIndex(i)
                            break
                elif rule_type_str == BiomeRuleType.DIFFERENT_FROM.value and biome_rule.args:
                    # Parse different from reference
                    from data.game_data import parse_different_from_arg

                    object_index, zone_name = parse_different_from_arg(biome_rule.args[0])
                    if object_index:
                        try:
                            different_object_spin.setValue(int(object_index))
                        except ValueError:
                            pass
                    if zone_name:
                        different_zone_combo.setCurrentText(zone_name)

        except Exception as e:
            logging.error(f"Error loading biome rule to UI for {rule_type}: {e}")
            # Set safe defaults to prevent UI issues
            try:
                if rule_type == "zone":
                    self.zone_biome_type_combo.setCurrentIndex(0)
                elif rule_type == "content":
                    self.content_biome_type_combo.setCurrentIndex(0)
                elif rule_type == "meta_objects":
                    self.meta_objects_biome_type_combo.setCurrentIndex(0)
            except:
                pass

