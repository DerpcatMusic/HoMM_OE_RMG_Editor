"""
Pydantic Data Models for RMG Editor

This module defines the core data models for the RMG map structure using Pydantic.
It ensures robust serialization, validation, and automatic snake_case to camelCase conversion.

Updated to match C# engine specifications from gamegenerator.cs.
"""

import logging
from typing import Any

from pydantic import BaseModel, ConfigDict, Field, field_validator, model_validator

# Import all enums for validation
from .enums import (
    BiomeRuleType,
    EMapGameMode,
    FactionRuleType,
    GraphOrientationMode,
    MainObjectPlacement,
    MainObjectType,
    PlacementRuleType,
    RoadTargetType,
    RoadType,
)

logger = logging.getLogger(__name__)

# --- Helper Functions & Base Classes ---


def to_camel_case(string: str) -> str:
    """Converts snake_case to camelCase."""
    components = string.split("_")
    if len(components) == 2 and components[1] == "zone":
        return components[0]
    return components[0] + "".join(x.title() for x in components[1:])


class RMG_BaseModel(BaseModel):
    """Base class for all RMG data models with automatic camelCase conversion."""

    model_config = ConfigDict(
        alias_generator=to_camel_case,
        populate_by_name=True,
        extra="allow",
        validate_assignment=True,
