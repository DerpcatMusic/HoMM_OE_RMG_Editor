    def _setup_connections(self):
        self.new_pool_btn.clicked.connect(self._on_new_pool)
        self.load_pool_btn.clicked.connect(self._on_load_pool)
        self.save_pool_btn.clicked.connect(self._on_save_pool)

        self.pool_content_tree.item_dropped.connect(self._on_item_dropped)
        self.remove_item_btn.clicked.connect(self._on_remove_item)
        self.edit_item_btn.clicked.connect(self._on_edit_item)
        self.pool_content_tree.itemDoubleClicked.connect(self._on_edit_item)

    def refresh_data(self):
        """Refreshes the list of available custom pools."""
        self.pool_combo.blockSignals(True)
        self.pool_combo.clear()
        pool_names = self.data_manager.get_custom_pool_names()
        if pool_names:
            self.pool_combo.addItems(sorted(pool_names))
        self.pool_combo.setCurrentIndex(-1)
        self.pool_combo.blockSignals(False)

    def _on_new_pool(self):
        if self._check_unsaved_changes():
            self._clear_editor()

    def _on_load_pool(self):
        if not self._check_unsaved_changes():
            return

        pool_name = self.pool_combo.currentText()
        if not pool_name:
            QMessageBox.warning(self, "No Pool Selected", "Please select a pool to load.")
            return

        pool_data = self.data_manager.get_content_pool(pool_name)
        if pool_data:
            self.current_pool_name = pool_name
            self.current_pool_data = pool_data
            self.pool_name_edit.setText(pool_name)
            self._populate_tree_with_pool_data()
            self._unsaved_changes = False
        else:
            QMessageBox.critical(self, "Error", f"Could not load data for pool '{pool_name}'.")

    def _on_save_pool(self):
        pool_name = self.pool_name_edit.text().strip()
        if not pool_name:
            QMessageBox.warning(self, "Invalid Name", "Pool name cannot be empty.")
            return

        # Build the pool data from the tree
        pool_content = []
        root = self.pool_content_tree.invisibleRootItem()
        for i in range(root.childCount()):
            item = root.child(i)
            item_data = item.data(0, Qt.ItemDataRole.UserRole)
            if isinstance(item_data, dict):
                pool_content.append(item_data)

        self.current_pool_data = {"name": pool_name, "content": pool_content}

        # Save to data manager
        self.data_manager.save_content_pool(pool_name, self.current_pool_data)
        self.current_pool_name = pool_name
        self._unsaved_changes = False
        self.pool_saved.emit(pool_name)
        self.refresh_data()
        self.pool_combo.setCurrentText(pool_name)
        QMessageBox.information(self, "Success", f"Pool '{pool_name}' saved successfully.")

    def _on_item_dropped(self, item_data: dict):
        sid = item_data.get("sid", "N/A")
        name = item_data.get("name", "Unknown")

        # Check for duplicates
        if self.pool_content_tree.findItems(sid, Qt.MatchFlag.MatchExactly, 0):
            return  # Item already in the pool

        # Create a new pool item structure
        new_pool_item = {"sid": sid, "weight": 100, "maxCount": 999}

        tree_item = QTreeWidgetItem([sid, "100", "999", name])
        tree_item.setData(0, Qt.ItemDataRole.UserRole, new_pool_item)
        self.pool_content_tree.addTopLevelItem(tree_item)
        self._mark_unsaved()

    def _on_remove_item(self):
        selected_items = self.pool_content_tree.selectedItems()
        if not selected_items:
            return

        reply = QMessageBox.question(
            self,
            "Remove Item",
            f"Remove {len(selected_items)} item(s) from the pool?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
        )

        if reply == QMessageBox.StandardButton.Yes:
            for item in selected_items:
                self.pool_content_tree.takeTopLevelItem(self.pool_content_tree.indexOfTopLevelItem(item))
            self._mark_unsaved()

    def _on_edit_item(self, item: QTreeWidgetItem):
        if not item:
            return

        item_data = item.data(0, Qt.ItemDataRole.UserRole)
        if not isinstance(item_data, dict):
            return

        dialog = EditPoolItemDialog(item_data.get("weight", 100), item_data.get("maxCount", 999), self)
        if dialog.exec():
            new_weight, new_max_count = dialog.get_values()

            # Update data
            item_data["weight"] = new_weight
            item_data["maxCount"] = new_max_count
            item.setData(0, Qt.ItemDataRole.UserRole, item_data)

            # Update view
            item.setText(1, str(new_weight))
            item.setText(2, str(new_max_count))
            self._mark_unsaved()

    def _populate_tree_with_pool_data(self):
        self.pool_content_tree.clear()
        content = self.current_pool_data.get("content", [])
        for pool_item in content:
            sid = pool_item.get("sid", "N/A")
            weight = pool_item.get("weight", 100)
            max_count = pool_item.get("maxCount", 999)

            # Find the object's display name from the data manager
            game_obj = self.data_manager.get_game_object_by_sid(sid)
            name = game_obj.get("name", "Unknown SID") if game_obj else "Unknown SID"

            tree_item = QTreeWidgetItem([sid, str(weight), str(max_count), name])
        tree_item.setData(0, Qt.ItemDataRole.UserRole, pool_item.copy())
        self.pool_content_tree.addTopLevelItem(tree_item)

    def _clear_editor(self):
        self.current_pool_name = None
        self.current_pool_data = {}
        self.pool_name_edit.clear()
        self.pool_content_tree.clear()
        self.pool_combo.setCurrentIndex(-1)
        self._unsaved_changes = False

    def _mark_unsaved(self):
        self._unsaved_changes = True

    def _check_unsaved_changes(self) -> bool:
        if not self._unsaved_changes:
            return True
        reply = QMessageBox.question(
            self,
            "Unsaved Changes",
            "You have unsaved changes in the content pool builder. Save them now?",
            QMessageBox.StandardButton.Save | QMessageBox.StandardButton.Discard | QMessageBox.StandardButton.Cancel,
        )
        if reply == QMessageBox.StandardButton.Save:
            self._on_save_pool()
            return True
        elif reply == QMessageBox.StandardButton.Discard:
            return True
        else:  # Cancel
            return False


