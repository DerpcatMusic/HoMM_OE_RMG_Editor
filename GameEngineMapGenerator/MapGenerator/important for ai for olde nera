    def _get_available_biomes(self) -> list:
        """Get available biomes using data manager or fallback to game data."""
        try:
            # First try data manager
            if self.data_manager:
                biomes = self.data_manager.get_available_biomes()
                logging.info(f"Data manager returned biomes: {biomes}")
                if biomes:
                    return biomes

            # Fallback to game data loader
            logging.info("Falling back to game data loader for biomes")
            game_data = get_game_data()
            biomes = game_data.get_biome_sids()
            logging.info(f"Game data loader returned biomes: {biomes}")
            return biomes

        except Exception as e:
            logging.error(f"Failed to load biomes: {e}")
            fallback_biomes = [
                "Grass",
                "Deathland",
                "Dirt",
                "Lava",
                "Sand",
                "Ice",
                "Autumn",
            ]
            logging.info(f"Using fallback biomes: {fallback_biomes}")
            return fallback_biomes

    def _populate_zone_combo_for_main_widget(self, combo_widget):
        """Populate a zone combo widget with actual zone names for the main widget."""
        try:
            # Get zone names from data manager if available
            zone_names = []
            if self.data_manager:
                # Try to get actual zone names from loaded templates
                if hasattr(self.data_manager, "map_templates"):
                    for template_name, template in list(self.data_manager.map_templates.items())[:5]:
                        if hasattr(template, "variants") and template.variants:
                            for variant in template.variants[:1]:  # First variant only
                                if hasattr(variant, "zones"):
                                    zone_names.extend([
                                        zone.name for zone in variant.zones if hasattr(zone, "name") and zone.name
                                    ])

            # Remove duplicates while preserving order
            seen = set()
            unique_zones = []
            for zone in zone_names:
                if zone not in seen:
                    seen.add(zone)
                    unique_zones.append(zone)

            if unique_zones:
                combo_widget.addItems(unique_zones[:20])  # Limit to 20
            else:
                # Fallback with common zone patterns
                fallback_zones = [
                    "Spawn-A",
                    "Spawn-B",
                    "Side-A",
                    "Side-B",
                    "Center",
                    "Player1",
                    "Player2",
                    "Neutral",
                    "North",
                    "South",
                ]
                combo_widget.addItems(fallback_zones)

        except Exception as e:
            import logging

            logging.warning(f"Failed to load zone names for main widget: {e}")
            # Fallback to basic patterns
            fallback_zones = ["Spawn-A", "Spawn-B", "Side-A", "Side-B", "Center"]
            combo_widget.addItems(fallback_zones)

