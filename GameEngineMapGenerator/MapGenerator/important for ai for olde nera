def get_enum_for_field(field_name: str, context: str = "") -> type[Enum] | None:
    """
    Get the appropriate enum class for a field name with context awareness.

    Args:
        field_name: The field name to look up
        context: Context path to help determine the correct enum type

    Returns:
        The appropriate enum class or None if no mapping exists
    """
    # Direct field mapping first
    if field_name in FIELD_ENUM_MAPPING:
        return FIELD_ENUM_MAPPING[field_name]

    # Context-sensitive mappings for 'type' field
    if field_name == "type":
        if "mainObjects" in context or "MainObject" in context:  # MapDescription.MainObject.type
            return MainObjectType
        elif "biome" in context.lower() or "Biome" in context:  # BiomeRule.type
            return BiomeRuleType
        elif "faction" in context.lower() or "Faction" in context:  # FactionRule.type
            return FactionRuleType
        elif "placement" in context.lower() and "rule" in context.lower():  # PlacementRule.type
            return PlacementRuleType
        elif "road" in context.lower() or "Road" in context:  # RoadConfig.type, RoadTargetConfig.type
            if "Target" in context or "target" in context:
                return RoadTargetType
            else:
                return RoadType
        elif "metaObjects" in context or "MetaObject" in context:  # MetaObjectConfig.type
            return MetaObjectType
        elif "template" in context.lower() and "encounter" in context.lower():  # EncounterTemplate.encounterType
            return EncounterTemplateType
        # Default to MainObjectType for backward compatibility (consider removing or making more specific)
        return MainObjectType

    return None


def validate_all_enums_in_dict(data: dict[str, Any], context: str = "") -> list[str]:
    """
    Validate all enum fields in a dictionary recursively.

    Args:
        data: Dictionary to validate
        context: Context path for error reporting

    Returns:
        List of validation error messages
    """
    errors = []

    for key, value in data.items():
        current_context = f"{context}.{key}" if context else key

        # Check if this field maps to an enum (with context awareness)
        enum_class = get_enum_for_field(key, current_context)
        if enum_class and isinstance(value, str):
            try:
                validate_enum_field(key, value, enum_class, current_context, strict=True)
            except EnumValidationError as e:
                errors.append(str(e))

        # Recurse into nested objects
        elif isinstance(value, dict):
            errors.extend(validate_all_enums_in_dict(value, current_context))

        # Recurse into arrays
        elif isinstance(value, list):
            for i, item in enumerate(value):
                if isinstance(item, dict):
                    errors.extend(validate_all_enums_in_dict(item, f"{current_context}[{i}]"))

    return errors


