    def validate_biome_rule(self, rule: BiomeRule) -> tuple[bool, str]:
        """
        Validate a biome rule against available data.

        Args:
            rule: BiomeRule to validate

        Returns:
            Tuple of (is_valid, error_message)
        """
        if rule.type == BiomeRuleType.FROM_LIST.value:
            for arg in rule.args:
                if arg not in self.tiles:
                    return False, f"Unknown biome SID: '{arg}'"

        return True, ""

    def resolve_biome_from_rule(self, rule: BiomeRule, context: dict[str, Any] | None = None) -> str | None:
        """
        Resolve a biome SID from a biome rule.

        Args:
            rule: BiomeRule to resolve
            context: Optional context for rule resolution

        Returns:
            Resolved biome SID or None
        """
        if rule.type == BiomeRuleType.FROM_LIST.value:
            if rule.args:
                # For now, return first valid biome
                for biome_sid in rule.args:
                    if biome_sid in self.tiles:
                        return biome_sid
        elif rule.type == BiomeRuleType.RANDOM.value:
            if self.tiles:
                import random

                return random.choice(list(self.tiles.keys()))

        return None

    def create_random_item_meta_object(self, rarity: str = "Common") -> MapObjectDesc | None:
        """
        Create a random item meta-object.

        Args:
            rarity: Item rarity (Common, Uncommon, Rare, Epic, Legendary)

        Returns:
            MapObjectDesc for random item or None
        """
        random_item_sid = META_OBJECT_SIDS.get("random_item")
        if random_item_sid and random_item_sid in self.meta_objects_by_sid:
            properties = {"rarity": rarity, "args": [rarity]}
            return MapObjectDesc(sid=random_item_sid, variant=-1, properties=properties, is_building=False)
        return None

