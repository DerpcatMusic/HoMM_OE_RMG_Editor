from PySide6.QtGui import QAction, QBrush, QColor
from PySide6.QtWidgets import (
    LineEdit,
    PushButton,
    QDoubleSpinBox,
    QFormLayout,
    QGroupBox,
    QHBoxLayout,
    QHeaderView,
    QLabel,
    QMenu,
    QMessageBox,
    QSplitter,
    QTreeWidgetItem,
    QVBoxLayout,
    QWidget,
    TreeWidget,
)

from data.data_manager import DataManager
from data.models import Zone
from data.zone_defaults import ZoneType


class ZonesWidget(QWidget):
    """Widget for managing zones with multi-selection and detailed view."""

    zone_selected = Signal(str)  # Single zone selected
    zones_selected = Signal(list)  # Multiple zones selected
    zone_focus_requested = Signal(str)  # Request to focus on specific zone in canvas

    def __init__(self, data_manager: DataManager, parent=None):
        super().__init__(parent)
        self.data_manager = data_manager
        self.zones: dict[str, Zone] = {}
        self.selected_zones: set[str] = set()
        self._updating = False  # Flag to prevent signal loops

        self._setup_ui()
        self._setup_connections()

    def _setup_ui(self):
        """Setup the user interface."""
        layout = QVBoxLayout(self)

        # Create splitter for zones list and details
        splitter = QSplitter(Qt.Orientation.Horizontal)
        layout.addWidget(splitter)

        # Left side - zones list
        zones_list_widget = self._create_zones_list()
        splitter.addWidget(zones_list_widget)

        # Right side - zone details (simple view)
        details_widget = self._create_zone_details()
        splitter.addWidget(details_widget)

        # Set splitter proportions
        splitter.setSizes([300, 200])

    def _create_zones_list(self) -> QWidget:
        """Create the zones list and management controls."""
        widget = QWidget()
        widget.setMinimumWidth(280)
        layout = QVBoxLayout(widget)

        # Title and management buttons
        title_layout = QHBoxLayout()
        title_label = QLabel("<b>Zones</b>")
        title_layout.addWidget(title_label)
        title_layout.addStretch()

        self.add_zone_btn = PushButton("Add Zone")
        self.add_zone_btn.clicked.connect(self._add_zone)
        title_layout.addWidget(self.add_zone_btn)

        self.delete_zones_btn = PushButton("Delete Selected")
        self.delete_zones_btn.clicked.connect(self._delete_selected_zones)
        self.delete_zones_btn.setEnabled(False)
        title_layout.addWidget(self.delete_zones_btn)

        layout.addLayout(title_layout)

        # Zones tree
        self.zones_tree = TreeWidget()
        self.zones_tree.setHeaderLabels(["Zone Name", "Size", "Layout", "Type"])
        self.zones_tree.setSelectionMode(TreeWidget.SelectionMode.ExtendedSelection)
        self.zones_tree.setAlternatingRowColors(True)
        self.zones_tree.itemSelectionChanged.connect(self._on_zone_selection_changed)
        self.zones_tree.itemDoubleClicked.connect(self._on_zone_double_clicked)
        self.zones_tree.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.zones_tree.customContextMenuRequested.connect(self._show_context_menu)

        # Configure column widths
        header = self.zones_tree.header()
        header.setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
        header.setSectionResizeMode(1, QHeaderView.ResizeMode.ResizeToContents)
        header.setSectionResizeMode(2, QHeaderView.ResizeMode.ResizeToContents)
        header.setSectionResizeMode(3, QHeaderView.ResizeMode.ResizeToContents)

        layout.addWidget(self.zones_tree)

        # Status label
        self.status_label = QLabel("No zones")
        self.status_label.setStyleSheet("color: #666; font-size: 10px;")
        layout.addWidget(self.status_label)

        return widget

    def _create_zone_details(self) -> QWidget:
        """Create zone details panel."""
        self.details_group = QGroupBox("Zone Details")
        layout = QFormLayout(self.details_group)

        # Zone name
        self.zone_name_edit = LineEdit()
        self.zone_name_edit.setReadOnly(True)
        layout.addRow("Name:", self.zone_name_edit)

        # Zone size
        self.zone_size_spin = QDoubleSpinBox()
        self.zone_size_spin.setReadOnly(True)
        self.zone_size_spin.setRange(0.1, 10.0)
        self.zone_size_spin.setSingleStep(0.1)
        layout.addRow("Size:", self.zone_size_spin)

        # Layout
        self.zone_layout_edit = LineEdit()
        self.zone_layout_edit.setReadOnly(True)
        layout.addRow("Layout:", self.zone_layout_edit)

        # Zone type (derived)
        self.zone_type_edit = LineEdit()
        self.zone_type_edit.setReadOnly(True)
        layout.addRow("Type:", self.zone_type_edit)

        # Selection info
        self.selection_info_label = QLabel("")
        self.selection_info_label.setStyleSheet("color: #666; font-size: 10px; font-style: italic;")
        layout.addRow("Selection:", self.selection_info_label)

        self._clear_zone_details()

        return self.details_group

    def _setup_connections(self):
        """Setup signal connections."""
        pass

    def set_zones(self, zones: dict[str, Zone]):
        """Set the zones to display."""
        self.zones = zones
        self._refresh_zones_list()

    def _refresh_zones_list(self):
        """Refresh the zones list."""
        self._updating = True
        try:
            self.zones_tree.clear()

            if not self.zones:
                self.status_label.setText("No zones")
                return

            zone_count = len(self.zones)
            self.status_label.setText(f"{zone_count} zone{'s' if zone_count != 1 else ''}")

            for zone_name, zone in self.zones.items():
                item = QTreeWidgetItem()
                self._populate_zone_item(item, zone_name, zone)
                self.zones_tree.addTopLevelItem(item)

                # Store zone name in item data
                item.setData(0, Qt.ItemDataRole.UserRole, zone_name)

                # Color code by zone type with very subtle tinting
                zone_type = self._determine_zone_type(zone)
                if zone_type:
                    color = QColor(zone_type.value[1])  # Get color from ZoneType enum
                    # Make the color very subtle (low alpha) - match connections widget
                    color.setAlpha(20)  # Very light tint (about 8% opacity)
                    brush = QBrush(color)
                    brush.setStyle(Qt.BrushStyle.SolidPattern)
                    for col in range(4):
                        item.setBackground(col, brush)

        finally:
            self._updating = False

    def _populate_zone_item(self, item: QTreeWidgetItem, zone_name: str, zone: Zone):
        """Populate a tree widget item with zone data."""
        item.setText(0, zone_name)
        item.setText(1, f"{zone.size:.1f}")
        item.setText(2, zone.layout)

        # Determine zone type
        zone_type = self._determine_zone_type(zone)
        item.setText(3, zone_type.value[0] if zone_type else "Unknown")

    def _determine_zone_type(self, zone: Zone) -> ZoneType | None:
        """Determine zone type based on zone properties."""
        zone_name = zone.name.lower()

        if "spawn" in zone_name or "start" in zone_name:
            return ZoneType.SPAWN
        elif "treasure" in zone_name or "bonus" in zone_name:
            return ZoneType.TREASURE
        elif "center" in zone_name or "central" in zone_name:
            return ZoneType.CENTER
        elif "junction" in zone_name or "crossroads" in zone_name:
            return ZoneType.JUNCTION
        elif "back" in zone_name:
            return ZoneType.BACK
        elif "side" in zone_name:
            return ZoneType.SIDE
        else:
            return ZoneType.NORMAL

    def _on_zone_selection_changed(self):
        """Handle zone selection changes."""
        if self._updating:
            return

        selected_items = self.zones_tree.selectedItems()
        selected_zone_names = []

        for item in selected_items:
            zone_name = item.data(0, Qt.ItemDataRole.UserRole)
            if zone_name:
                selected_zone_names.append(zone_name)

        self.selected_zones = set(selected_zone_names)

        # Update button states
        self.delete_zones_btn.setEnabled(len(self.selected_zones) > 0)

        # Update details panel
        if len(self.selected_zones) == 1:
            zone_name = list(self.selected_zones)[0]
            self._show_zone_details(zone_name)
            self.zone_selected.emit(zone_name)
        else:
            self._show_selection_summary()
            if self.selected_zones:
                self.zones_selected.emit(list(self.selected_zones))

        logging.debug(f"Selected zones: {self.selected_zones}")

    def _on_zone_double_clicked(self, item: QTreeWidgetItem, column: int):
        """Handle zone double-click to focus on canvas."""
        zone_name = item.data(0, Qt.ItemDataRole.UserRole)
        if zone_name:
            self.zone_focus_requested.emit(zone_name)
            logging.debug(f"Focus requested for zone: {zone_name}")

    def _show_zone_details(self, zone_name: str):
        """Show details for a single zone."""
        if zone_name not in self.zones:
            self._clear_zone_details()
            return

        zone = self.zones[zone_name]

        self.zone_name_edit.setText(zone_name)
        self.zone_size_spin.setValue(zone.size)
        self.zone_layout_edit.setText(zone.layout)

        zone_type = self._determine_zone_type(zone)
        self.zone_type_edit.setText(zone_type.value[0] if zone_type else "Unknown")

        self.selection_info_label.setText("Single zone selected")

    def _show_selection_summary(self):
        """Show summary for multiple selected zones."""
        count = len(self.selected_zones)
        if count == 0:
            self._clear_zone_details()
            return

        self.zone_name_edit.setText(f"<{count} zones selected>")
        self.zone_size_spin.setValue(0.0)
        self.zone_layout_edit.setText("<multiple>")
        self.zone_type_edit.setText("<multiple>")

        self.selection_info_label.setText(f"{count} zones selected")

    def _clear_zone_details(self):
        """Clear the zone details panel."""
        self.zone_name_edit.setText("")
        self.zone_size_spin.setValue(0.0)
        self.zone_layout_edit.setText("")
        self.zone_type_edit.setText("")
        self.selection_info_label.setText("No selection")

    def _show_context_menu(self, position):
        """Show context menu for zones list."""
        item = self.zones_tree.itemAt(position)

        menu = QMenu(self)

        if item:
            zone_name = item.data(0, Qt.ItemDataRole.UserRole)

            # Focus on canvas
            focus_action = QAction("Focus on Canvas", self)
            focus_action.triggered.connect(lambda: self.zone_focus_requested.emit(zone_name))
            menu.addAction(focus_action)

            menu.addSeparator()

        # Add zone
        add_action = QAction("Add Zone", self)
        add_action.triggered.connect(self._add_zone)
        menu.addAction(add_action)

        # Delete selected zones (if any selected)
        if self.selected_zones:
            delete_action = QAction(f"Delete Selected ({len(self.selected_zones)})", self)
            delete_action.triggered.connect(self._delete_selected_zones)
            menu.addAction(delete_action)

        menu.exec(self.zones_tree.mapToGlobal(position))

    def _add_zone(self):
        """Add a new zone."""
        # This would typically open a zone creation dialog
        # For now, we'll emit a signal that the parent can handle
        logging.info("Add zone requested")
        # Could emit a signal here for the main window to handle

    def _delete_selected_zones(self):
        """Delete selected zones."""
        if not self.selected_zones:
            return

        zone_names = list(self.selected_zones)
        count = len(zone_names)

        # Confirm deletion
        reply = QMessageBox.question(
            self,
            "Delete Zones",
            f"Are you sure you want to delete {count} zone{'s' if count != 1 else ''}?\n\n"
            + "\n".join(f"• {name}" for name in zone_names[:10])
            + (f"\n... and {count - 10} more" if count > 10 else ""),
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            QMessageBox.StandardButton.No,
        )

        if reply == QMessageBox.StandardButton.Yes:
            # Remove zones from data
            for zone_name in zone_names:
                if zone_name in self.zones:
                    del self.zones[zone_name]

            # Clear selection
            self.selected_zones.clear()

            # Refresh display
            self._refresh_zones_list()
            self._clear_zone_details()

            # Emit signal about deletion
            self.zones_selected.emit([])  # Clear selection

            logging.info(f"Deleted {count} zones: {zone_names}")

    def select_zone(self, zone_name: str):
        """Select a specific zone (called from canvas selection)."""
        if not zone_name or zone_name not in self.zones:
            self.zones_tree.clearSelection()
            return

        self._updating = True
        try:
            # Clear current selection
            self.zones_tree.clearSelection()

            # Find and select the zone item
            for i in range(self.zones_tree.topLevelItemCount()):
                item = self.zones_tree.topLevelItem(i)
                item_zone_name = item.data(0, Qt.ItemDataRole.UserRole)
                if item_zone_name == zone_name:
                    item.setSelected(True)
                    self.zones_tree.scrollToItem(item)
                    break

        finally:
            self._updating = False

        # Update selection tracking
        self.selected_zones = {zone_name}
        self._show_zone_details(zone_name)
        self.delete_zones_btn.setEnabled(True)

    def get_selected_zones(self) -> list[str]:
        """Get list of currently selected zone names."""
        return list(self.selected_zones)

    def clear_selection(self):
        """Clear zone selection."""
        self._updating = True
        try:
            self.zones_tree.clearSelection()
        finally:
            self._updating = False

        self.selected_zones.clear()
        self._clear_zone_details()
        self.delete_zones_btn.setEnabled(False)
"""
Variant Settings Widget

A dedicated widget for editing the global settings of a map variant, including
Orientation, Border, and River configurations.
# Force reload to bypass Python cache
"""

from PySide6.QtCore import Signal
from PySide6.QtWidgets import (
    QFormLayout,
    QVBoxLayout,
    QWidget,
)

from data.data_manager import DataManager
from data.enums import GraphOrientationMode, get_enum_values
from data.models import NoiseMode, Variant
from ui.fluent_widgets import (
    CardWidget,
    CheckBox,
    ComboBox,
    DoubleSpinBox,
    LineEdit,
    ScrollArea,
    SpinBox,
    StrongBodyLabel,
)


class VariantSettingsWidget(QWidget):
    """Widget for editing Variant-level map settings."""

    variant_changed = Signal()

    def __init__(self, data_manager: DataManager, parent: QWidget | None = None):
        super().__init__(parent)
        self.data_manager = data_manager
        self.current_variant: Variant | None = None
        self._updating = False

        self._setup_ui()
        self._setup_connections()
        self.setEnabled(False)

    def _setup_ui(self):
        main_layout = QVBoxLayout(self)
        main_layout.setContentsMargins(0, 0, 0, 0)

        # Use a scroll area to handle potentially large content
        scroll_area = ScrollArea()
        scroll_area.setWidgetResizable(True)
        content_widget = QWidget()
        layout = QVBoxLayout(content_widget)

        # --- Orientation Group ---
        orientation_group = CardWidget()
        orientation_layout = QVBoxLayout(orientation_group)
        orientation_layout.addWidget(StrongBodyLabel("Orientation", orientation_group))

        orientation_form = QFormLayout()
        orientation_form.setContentsMargins(0, 10, 0, 0)

        self.orientation_mode_combo = ComboBox()
        self.orientation_mode_combo.addItems(get_enum_values(GraphOrientationMode))
        self.zero_angle_zone_combo = ComboBox()
        self.zero_angle_zone_combo.setEditable(True)
        self.base_angle_min_spin = self._create_angle_spinbox()
        self.base_angle_max_spin = self._create_angle_spinbox()
        self.random_angle_amp_spin = self._create_angle_spinbox()
        self.random_angle_step_spin = self._create_angle_spinbox()

        orientation_form.addRow("Mode:", self.orientation_mode_combo)
        orientation_form.addRow("Reference Zone:", self.zero_angle_zone_combo)
        orientation_form.addRow("Base Angle Min:", self.base_angle_min_spin)
        orientation_form.addRow("Base Angle Max:", self.base_angle_max_spin)
        orientation_form.addRow("Random Angle Amp:", self.random_angle_amp_spin)
        orientation_form.addRow("Random Angle Step:", self.random_angle_step_spin)

        orientation_layout.addLayout(orientation_form)
        layout.addWidget(orientation_group)

        # --- Border Group ---
        border_group = CardWidget()
        border_layout = QVBoxLayout(border_group)
        border_layout.addWidget(StrongBodyLabel("Border", border_group))

        border_form = QFormLayout()
        border_form.setContentsMargins(0, 10, 0, 0)

        self.corner_radius_spin = QDoubleSpinBox()
        self.corner_radius_spin.setRange(0.0, 1.0)
        self.corner_radius_spin.setSingleStep(0.05)
        self.obstacles_width_spin = SpinBox()
        self.obstacles_width_spin.setRange(0, 50)
        self.water_width_spin = SpinBox()
        self.water_width_spin.setRange(0, 50)
        self.water_type_combo = ComboBox()
        self.water_type_combo.setEditable(True)

        border_form.addRow("Corner Radius:", self.corner_radius_spin)
        border_form.addRow("Obstacles Width:", self.obstacles_width_spin)
        border_form.addRow("Water Width:", self.water_width_spin)
        border_form.addRow("Water Type:", self.water_type_combo)

        # Simplified Noise settings for obstacles and water
        self.obs_noise_amp_spin = self._create_noise_spinbox("Amplitude")
        self.obs_noise_freq_spin = self._create_noise_spinbox("Frequency")
        self.water_noise_amp_spin = self._create_noise_spinbox("Amplitude")
        self.water_noise_freq_spin = self._create_noise_spinbox("Frequency")

        border_form.addRow(StrongBodyLabel("Obstacles Noise:", border_group))
        border_form.addRow("Amplitude:", self.obs_noise_amp_spin)
        border_form.addRow("Frequency:", self.obs_noise_freq_spin)
        border_form.addRow(StrongBodyLabel("Water Noise:", border_group))
        border_form.addRow("Amplitude:", self.water_noise_amp_spin)
        border_form.addRow("Frequency:", self.water_noise_freq_spin)

        border_layout.addLayout(border_form)
        layout.addWidget(border_group)

        # --- River Group ---
        river_group = CardWidget()
        river_layout = QVBoxLayout(river_group)
        river_layout.addWidget(StrongBodyLabel("Rivers", river_group))

        river_form = QFormLayout()
        river_form.setContentsMargins(0, 10, 0, 0)

        self.create_river_check = CheckBox("Create River System")
        self.tributary_spacing_spin = QDoubleSpinBox()
        self.tributary_spacing_spin.setRange(5.0, 100.0)
        self.tributary_spacing_spin.setSingleStep(1.0)

        river_form.addRow(self.create_river_check)
        river_form.addRow("Tributary Spacing:", self.tributary_spacing_spin)

        river_layout.addLayout(river_form)
        layout.addWidget(river_group)

        layout.addStretch()
        scroll_area.setWidget(content_widget)
        main_layout.addWidget(scroll_area)

    def _create_angle_spinbox(self) -> DoubleSpinBox:
        spin = QDoubleSpinBox()
        spin.setRange(0.0, 360.0)
        spin.setSingleStep(5.0)
        spin.setSuffix("°")
        return spin

    def _create_noise_spinbox(self, placeholder: str) -> DoubleSpinBox:
        spin = QDoubleSpinBox()
        spin.setRange(0.0, 100.0)
        spin.setSingleStep(0.1)
        spin.setDecimals(2)
        return spin

    def _setup_connections(self):
        widgets_to_connect = [
            self.orientation_mode_combo,
            self.zero_angle_zone_combo,
            self.base_angle_min_spin,
            self.base_angle_max_spin,
            self.random_angle_amp_spin,
            self.random_angle_step_spin,
            self.corner_radius_spin,
            self.obstacles_width_spin,
            self.water_width_spin,
            self.water_type_combo,
            self.obs_noise_amp_spin,
            self.obs_noise_freq_spin,
            self.water_noise_amp_spin,
            self.water_noise_freq_spin,
            self.create_river_check,
            self.tributary_spacing_spin,
        ]

        for widget in widgets_to_connect:
            if isinstance(widget, ComboBox):
                widget.currentTextChanged.connect(self._on_property_changed)
            elif isinstance(widget, (SpinBox, DoubleSpinBox)):
                widget.valueChanged.connect(self._on_property_changed)
            elif isinstance(widget, CheckBox):
                widget.toggled.connect(self._on_property_changed)

    def set_variant(self, variant: Variant | None, all_zones: list[str] = []):
        self.current_variant = variant
        if variant:
            self._updating = True
            self.setEnabled(True)
            self._load_variant_data(variant, all_zones)
            self._updating = False
        else:
            self._updating = True
            self._clear_ui()
            self.setEnabled(False)
            self._updating = False

    def _load_variant_data(self, variant: Variant, all_zones: list[str]):
        # Orientation
        self.orientation_mode_combo.setCurrentText(variant.orientation.mode)
        self.zero_angle_zone_combo.clear()
        self.zero_angle_zone_combo.addItems([""] + all_zones)
        self.zero_angle_zone_combo.setCurrentText(variant.orientation.zero_angle_zone)
        self.base_angle_min_spin.setValue(variant.orientation.base_angle_min)
        self.base_angle_max_spin.setValue(variant.orientation.base_angle_max)
        self.random_angle_amp_spin.setValue(variant.orientation.random_angle_amplitude)
        self.random_angle_step_spin.setValue(variant.orientation.random_angle_step)

        # Border
        self.corner_radius_spin.setValue(variant.border.corner_radius)
        self.obstacles_width_spin.setValue(variant.border.obstacles_width)
        self.water_width_spin.setValue(variant.border.water_width)
        self.water_type_combo.setCurrentText(variant.border.water_type)

        # Noise (simplified: edit first or create new)
        obs_noise = variant.border.obstacles_noise[0] if variant.border.obstacles_noise else NoiseMode()
        self.obs_noise_amp_spin.setValue(obs_noise.amp)
        self.obs_noise_freq_spin.setValue(obs_noise.freq)

        water_noise = variant.border.water_noise[0] if variant.border.water_noise else NoiseMode()
        self.water_noise_amp_spin.setValue(water_noise.amp)
        self.water_noise_freq_spin.setValue(water_noise.freq)

        # Rivers
        if variant.river_settings:
            self.create_river_check.setChecked(variant.river_settings.create_river_system)
            self.tributary_spacing_spin.setValue(variant.river_settings.tributary_spacing)
        else:
            self.create_river_check.setChecked(False)
            self.tributary_spacing_spin.setValue(25.0)  # Default value

    def update_variant(self, variant: Variant):
        if not variant:
            return

        # Orientation
        variant.orientation.mode = self.orientation_mode_combo.currentText()
        variant.orientation.zero_angle_zone = self.zero_angle_zone_combo.currentText()
        variant.orientation.base_angle_min = int(self.base_angle_min_spin.value())
        variant.orientation.base_angle_max = int(self.base_angle_max_spin.value())
        variant.orientation.random_angle_amplitude = int(self.random_angle_amp_spin.value())
        variant.orientation.random_angle_step = int(self.random_angle_step_spin.value())

        # Border
        variant.border.corner_radius = self.corner_radius_spin.value()
        variant.border.obstacles_width = self.obstacles_width_spin.value()
        variant.border.water_width = self.water_width_spin.value()
        variant.border.water_type = self.water_type_combo.currentText()

        # Noise
        variant.border.obstacles_noise = [
            NoiseMode(amp=self.obs_noise_amp_spin.value(), freq=self.obs_noise_freq_spin.value())
        ]
        variant.border.water_noise = [
            NoiseMode(amp=self.water_noise_amp_spin.value(), freq=self.water_noise_freq_spin.value())
        ]

        # Rivers
        if not variant.river_settings:
            from data.models import RiverSettings

            variant.river_settings = RiverSettings()
        variant.river_settings.create_river_system = self.create_river_check.isChecked()
        variant.river_settings.tributary_spacing = self.tributary_spacing_spin.value()

    def _clear_ui(self):
        # Clear all fields, usually called when no variant is selected
        for child in self.findChildren(QWidget):
            if isinstance(child, (LineEdit, ComboBox)):
                child.blockSignals(True)
                if isinstance(child, ComboBox):
                    child.setCurrentIndex(-1)
                else:
                    child.clear()
                child.blockSignals(False)
            elif isinstance(child, (SpinBox, DoubleSpinBox)):
                child.blockSignals(True)
                child.setValue(0)
                child.blockSignals(False)
            elif isinstance(child, CheckBox):
                child.blockSignals(True)
                child.setChecked(False)
                child.blockSignals(False)

