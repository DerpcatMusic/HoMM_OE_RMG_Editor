    # Gate placement settings (missing from original Python model)
    gate_placement: str = Field(default="Random", alias="gatePlacement")  # GatePlacement enum as string
    gate_placement_args: list[str] = Field(
        default_factory=list, alias="gatePlacementArgs"
    )  # Arguments for gate placement

    portal_placement_rules_from: list[PlacementRule] = Field(default_factory=list, alias="portalPlacementRulesFrom")
    portal_placement_rules_to: list[PlacementRule] = Field(default_factory=list, alias="portalPlacementRulesTo")

    @field_validator("connection_type")
    @classmethod
    def validate_connection_type(cls, v):
        """Validate connection type matches C# ConnectionType enum values."""
        valid_types = ["Default", "Direct", "Portal", "Proximity", "GladiatorArena"]
        if v not in valid_types:
            raise ValueError(f"Invalid connection type '{v}'. Must be one of: {valid_types}")
        return v

    @field_validator("guard_reaction")
    @classmethod
    def validate_guard_reaction(cls, v):
        """Validate guard reaction matches C# ESquadReactionType enum values."""
        if v is None or v == "":
            return v
        valid_reactions = ["Common", "Aggressive", "Friendly", "Hostile", "Compliant"]
        if v not in valid_reactions:
            raise ValueError(f"Invalid guard reaction '{v}'. Must be one of: {valid_reactions}")
        return v

    @field_validator("gate_placement")
    @classmethod
    def validate_gate_placement(cls, v):
        """Validate gate placement matches C# GatePlacement enum values."""
        valid_placements = ["Random", "Center", "NearZone"]
        if v not in valid_placements:
            raise ValueError(f"Invalid gate placement '{v}'. Must be one of: {valid_placements}")
        return v

    @model_validator(mode="after")
    def validate_connection_constraints(self):
        """Validate connection based on C# connection type constraints."""
        connection_type = self.connection_type

        # Portal connections must have at least one portal enabled
        if connection_type == "Portal":
            if not self.portal_from_enabled and not self.portal_to_enabled:
                raise ValueError("Portal connections must have at least one portal enabled (From or To)")

        # Proximity connections have special constraints
        if connection_type == "Proximity":
            # Proximity connections don't use standard guard zones in the same way
            if self.guard_zone and self.guard_zone != "":
                logger.warning(
                    f"Proximity connection '{self.name}' has guard zone '{self.guard_zone}' - this may not behave as expected"
                )

        return self

    def needs_ground_connection(self) -> bool:
        """Check if this connection type needs a ground connection (C# NeedsGroundConnection extension method)."""
        return self.connection_type in ["Direct", "GladiatorArena"]

    def can_have_ground_connection(self) -> bool:
        """Check if this connection type can have a ground connection (C# CanHaveGroundConnection extension method)."""
        return self.connection_type in ["Direct", "GladiatorArena", "Default"]

    def needs_adjacency(self) -> bool:
        """Check if this connection type needs zone adjacency (C# NeedsAdjacency extension method)."""
        return self.connection_type in ["Direct", "GladiatorArena", "Proximity"]

    def supports_portals(self) -> bool:
        """Check if this connection type supports portal settings."""
        return self.connection_type in ["Portal", "Default"]

    def supports_guard_zones(self) -> bool:
        """Check if this connection type supports guard zone settings."""
        return self.connection_type in ["Default", "Direct", "Portal"]


