    def _add_road(self) -> None:
        """Add a new road configuration."""
        if not self.current_zone:
            return

        connections = []
        if self.data_manager and self.data_manager.current_map and self.data_manager.current_map.variants:
            connections = self.data_manager.current_map.variants[0].connections
        dialog = RoadEditDialog(
            data_manager=self.data_manager,
            parent=self,
            zone=self.current_zone,
            connections=connections,
        )
        if dialog.exec() == QDialog.DialogCode.Accepted:
            self.current_zone.roads.append(dialog.road_config)
            self._refresh_roads_list()
            self.zone_changed.emit()

    def _edit_road(self) -> None:
        """Edit the selected road configuration."""
        if not self.current_zone:
            return

        current_row = self.roads_list.currentRow()
        if current_row < 0 or current_row >= len(self.current_zone.roads):
            QMessageBox.information(self, "Edit Road", "Please select a road to edit.")
            return

        road_config = self.current_zone.roads[current_row]
        connections = []
        if self.data_manager and self.data_manager.current_map and self.data_manager.current_map.variants:
            connections = self.data_manager.current_map.variants[0].connections
        dialog = RoadEditDialog(road_config, self.data_manager, self, zone=self.current_zone, connections=connections)
        if dialog.exec() == QDialog.DialogCode.Accepted:
            self._refresh_roads_list()
            self.zone_changed.emit()

    def _remove_road(self) -> None:
        """Remove the selected road configuration."""
        if not self.current_zone:
            return

        current_row = self.roads_list.currentRow()
        if current_row < 0 or current_row >= len(self.current_zone.roads):
