    def _process_json_file(
        self,
        json_file: Path,
        config: dict[str, str],
        display_name: str,
        game_objects: dict[str, list[dict[str, Any]]],
    ):
        """Processes a single JSON file for game objects."""
        data = self._load_json_file(json_file)
        if not data:
            return

        items = self._extract_items_from_data(data)

        for item in items:
            if isinstance(item, dict):
                game_object = self._create_game_object(item, json_file, config["icon"], display_name)
                if game_object:
                    game_objects[display_name].append(game_object)

    def _extract_items_from_data(self, data: Any) -> list[dict[str, Any]]:
        """Extracts a list of items from the loaded JSON data."""
        if isinstance(data, list):
            return data
        if isinstance(data, dict):
            if "array" in data and isinstance(data["array"], list):
                return data["array"]
            return [data]
        return []

    def _create_game_object(
        self, item_data: dict[str, Any], json_file: Path, icon: str, category: str
    ) -> dict[str, Any] | None:
        sid = item_data.get("sid", item_data.get("id", json_file.stem))
        if not sid:
            return None

        name = item_data.get("name", item_data.get("displayName", sid))

        return {
            "sid": str(sid),
            "name": str(name),
            "category": category,
            "icon": icon,
            "file_path": str(json_file.relative_to(self.base_path)) if self.base_path else str(json_file),
            "raw_data": item_data,
        }

