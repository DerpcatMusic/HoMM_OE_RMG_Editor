    def _connect_signals(self):
        self.rule_type_combo.currentTextChanged.connect(self._on_rule_type_changed)

    def _on_rule_type_changed(self):
        """Update UI based on selected rule type."""
        rule_type = self.rule_type_combo.currentText()

        # Show/hide appropriate controls
        self.biome_list_widget.setVisible(rule_type == BiomeRuleType.FROM_LIST.value)
        self.different_from_object_spin.setVisible(rule_type == BiomeRuleType.DIFFERENT_FROM.value)
        self.different_from_zone_combo.setVisible(rule_type == BiomeRuleType.DIFFERENT_FROM.value)
        self.main_object_combo.setVisible(rule_type == BiomeRuleType.MATCH_MAIN_OBJECT.value)

    def _load_data(self):
        """Load existing biome rule data."""
        if self.biome_rule:
            try:
                self.rule_type_combo.setCurrentText(self.biome_rule.type)
                self._on_rule_type_changed()

                if self.biome_rule.args:
                    rule_type = self.biome_rule.type
                    if rule_type == BiomeRuleType.FROM_LIST.value:
                        # Select biomes in the list
                        for i in range(self.biome_list_widget.count()):
                            item = self.biome_list_widget.item(i)
                            if item.text() in self.biome_rule.args:
                                item.setSelected(True)
                    elif rule_type == BiomeRuleType.DIFFERENT_FROM.value:
                        # Load different from reference
                        if self.biome_rule.args:
                            from data.game_data import parse_different_from_arg

                            object_index, zone_name = parse_different_from_arg(self.biome_rule.args[0])
                            if object_index:
                                try:
                                    self.different_from_object_spin.setValue(int(object_index))
                                except ValueError:
                                    pass
                            if zone_name:
                                self.different_from_zone_combo.setCurrentText(zone_name)
                    elif rule_type == BiomeRuleType.MATCH_MAIN_OBJECT.value and self.biome_rule.args:
                        self.main_object_combo.setCurrentText(self.biome_rule.args[0])
            except Exception as e:
                logging.warning(f"Error loading biome rule data: {e}")

    def _save_and_accept(self):
        """Save form data to biome rule and accept."""
        # Find the enum value that matches the text
        for biome_type in BiomeRuleType:
            if biome_type.value == self.rule_type_combo.currentText():
                self.biome_rule.type = biome_type
                break

        rule_type = self.biome_rule.type
        if rule_type == BiomeRuleType.FROM_LIST.value:
            # Get selected biomes
            selected_biomes = []
            for i in range(self.biome_list_widget.count()):
                item = self.biome_list_widget.item(i)
                if item.isSelected():
                    selected_biomes.append(item.text())
            self.biome_rule.args = selected_biomes
        elif rule_type == BiomeRuleType.DIFFERENT_FROM.value:
            # Get different from reference
            object_index = self.different_from_object_spin.value()
            zone_name = self.different_from_zone_combo.currentText()
            if zone_name:
                different_from_ref = f"differentFrom: {object_index} {zone_name}"
                self.biome_rule.args = [different_from_ref]
            else:
                self.biome_rule.args = []
        elif rule_type == BiomeRuleType.MATCH_MAIN_OBJECT.value:
            # Get main object index
            self.biome_rule.args = (
                [self.main_object_combo.currentText()] if self.main_object_combo.currentText() else []
            )
        else:
            # MatchZone needs no arguments
            self.biome_rule.args = []

        self.accept()

    def _get_available_biomes_for_dialog(self) -> list:
        """Get available biomes for dialog."""
        try:
            # First try data manager
            if self.data_manager:
                biomes = self.data_manager.get_available_biomes()
                if biomes:
                    return biomes

            # Fallback to game data loader
            game_data = get_game_data()
            return game_data.get_biome_sids()

        except Exception as e:
            logging.warning(f"Failed to load biomes: {e}")
            return ["Grass", "Deathland", "Dirt", "Lava", "Sand", "Ice", "Autumn"]

    def _populate_zone_combo_for_dialog(self):
        """Populate the zone combo with actual zone names from game data."""
        try:
            # Get zone names from data manager if available
            zone_names = []
            if self.data_manager:
                # Try to get actual zone names from loaded templates
                if hasattr(self.data_manager, "map_templates"):
                    for template_name, template in list(self.data_manager.map_templates.items())[:5]:
                        if hasattr(template, "variants") and template.variants:
                            for variant in template.variants[:1]:  # First variant only
                                if hasattr(variant, "zones"):
                                    zone_names.extend([
                                        zone.name for zone in variant.zones if hasattr(zone, "name") and zone.name
                                    ])

            # Remove duplicates while preserving order
            seen = set()
            unique_zones = []
            for zone in zone_names:
                if zone not in seen:
                    seen.add(zone)
                    unique_zones.append(zone)

            if unique_zones:
                self.different_from_zone_combo.addItems(unique_zones[:20])  # Limit to 20
            else:
                # Last resort fallback with common zone patterns
                fallback_zones = [
                    "Spawn-A",
                    "Spawn-B",
                    "Side-A",
                    "Side-B",
                    "Center",
                    "Player1",
                    "Player2",
                    "Neutral",
                    "North",
                    "South",
                    "East",
                    "West",
                ]
                self.different_from_zone_combo.addItems(fallback_zones)

        except Exception as e:
            logging.warning(f"Failed to load zone names: {e}")
            # Fallback to common patterns
            fallback_zones = ["Spawn-A", "Spawn-B", "Side-A", "Side-B", "Center"]
            self.different_from_zone_combo.addItems(fallback_zones)

