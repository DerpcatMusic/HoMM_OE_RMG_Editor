        """Handle data changes."""
        if self._updating or not self.current_layout:
            return

        self._update_layout_from_ui()
        self.layoutChanged.emit(self.current_layout)

    def _update_layout_from_ui(self):
        """Update the current layout from UI values."""
        if not self.current_layout:
            return

        self.current_layout.name = self.name_edit.text()
        self.current_layout.obstacles_fill = self.obstacles_fill_slider.value()
        self.current_layout.obstacles_fill_void = self.obstacles_fill_void_slider.value()
        self.current_layout.lakes_fill = self.lakes_fill_slider.value()
        self.current_layout.min_lake_area = self.min_lake_area_spin.value()
        self.current_layout.elevation_cluster_scale = self.elevation_cluster_scale_slider.value()
        self.current_layout.road_cluster_area = self.road_cluster_area_spin.value()

        # Update sub-configurations
        self.current_layout.guarded_encounter_resource_fractions = self.resource_fraction_widget.get_distribution()
        self.current_layout.ambient_pickup_distribution = self.ambient_pickup_widget.get_distribution()

    def set_layout(self, layout: ZoneLayoutConfig):
        """Set the layout to edit."""
        self._updating = True
        try:
            self.current_layout = layout

            # Update UI
            self.name_edit.setText(layout.name)
            self.obstacles_fill_slider.setValue(layout.obstacles_fill)
            self.obstacles_fill_void_slider.setValue(layout.obstacles_fill_void)
            self.lakes_fill_slider.setValue(layout.lakes_fill)
            self.min_lake_area_spin.setValue(layout.min_lake_area)
            self.elevation_cluster_scale_slider.setValue(layout.elevation_cluster_scale)
            self.road_cluster_area_spin.setValue(layout.road_cluster_area)

            # Update sub-widgets
            self.resource_fraction_widget.set_distribution(layout.guarded_encounter_resource_fractions)
            self.ambient_pickup_widget.set_distribution(layout.ambient_pickup_distribution)

        finally:
            self._updating = False

    def get_layout(self) -> ZoneLayoutConfig:
        """Get the current layout."""
        if self.current_layout:
            self._update_layout_from_ui()
        return self.current_layout

    def _reset_to_defaults(self):
        """Reset to default values."""
        default_layout = ZoneLayoutConfig(name=self.name_edit.text() or "default")
        self.set_layout(default_layout)
        self.layoutChanged.emit(default_layout)

    def _validate_configuration(self):
        """Validate the current configuration."""
        if not self.current_layout:
            QMessageBox.warning(self, "Validation", "No layout to validate.")
            return

        try:
            self._update_layout_from_ui()

            # Basic validation
            errors = []

            if not self.current_layout.name.strip():
                errors.append("Layout name cannot be empty")

            if self.current_layout.obstacles_fill < 0 or self.current_layout.obstacles_fill > 1:
                errors.append("Obstacles fill must be between 0.0 and 1.0")

            if self.current_layout.lakes_fill < 0 or self.current_layout.lakes_fill > 1:
                errors.append("Lakes fill must be between 0.0 and 1.0")

            if self.current_layout.min_lake_area < 1:
                errors.append("Minimum lake area must be at least 1")

            if self.current_layout.elevation_cluster_scale < 0 or self.current_layout.elevation_cluster_scale > 1:
                errors.append("Elevation cluster scale must be between 0.0 and 1.0")

            # Validate resource fractions
            resource_dist = self.current_layout.guarded_encounter_resource_fractions
            if len(resource_dist.weights) != len(resource_dist.price_bounds) + 1:
                errors.append("Number of resource weights must be number of price bounds + 1")

            if errors:
                QMessageBox.warning(
                    self,
                    "Validation Errors",
                    "The following validation errors were found:\n\n" + "\n".join(f"• {error}" for error in errors),
                )
            else:
                QMessageBox.information(self, "Validation", "Configuration is valid!")

        except Exception as e:
            logger.error(f"Validation error: {e}")
            QMessageBox.critical(self, "Validation Error", f"An error occurred during validation:\n{e}")
