        content = self.get_mandatory_content()
        self.content_changed.emit(content)

    def get_mandatory_content(self):
        """Get the current MandatoryContent object."""
        return MandatoryContent(
            name=self.name_edit.text(),
            sid=self.sid_combo.currentText(),
            variant=self.variant_spin.value(),
            designated_encounter=self.designated_encounter_check.isChecked(),
