def validate_dependencies(data: dict[str, Any]) -> list[str]:
    """
    Validate all dependency rules against the data.

    Args:
        data: Complete RMG JSON dictionary

    Returns:
        List of dependency violation messages
    """
    violations = []

    for rule in DEPENDENCY_RULES:
        if rule.applies(data):
            # Check if the dependency constraint is violated
            target_value = rule._get_nested_value(data, rule.target_field)

            if rule.action == "require" and not target_value or rule.action == "forbid" and target_value:
                violations.append(f"Dependency violation: {rule.message}")
            elif rule.action == "disable" and target_value:
                violations.append(f"Warning: {rule.message}")

    return violations


