class DependencyRule:
    """Represents a dependency rule between two settings."""

    def __init__(
        self,
        source_field: str,
        source_value: Any,
        target_field: str,
        action: str,
        message: str = "",
    ):
        self.source_field = source_field
        self.source_value = source_value
        self.target_field = target_field
        self.action = action  # "disable", "enable", "require", "forbid"
        self.message = message

    def applies(self, data: dict[str, Any]) -> bool:
        """Check if this rule applies to the current data."""
        source_val = self._get_nested_value(data, self.source_field)
        if self.source_value == "*":
            return source_val is not None
        return source_val == self.source_value

    def _get_nested_value(self, data: dict[str, Any], field_path: str) -> Any:
        """Get value from nested dictionary using dot notation."""
        keys = field_path.split(".")
        current = data
        for key in keys:
            if isinstance(current, dict) and key in current:
                current = current[key]
            else:
                return None
        return current


