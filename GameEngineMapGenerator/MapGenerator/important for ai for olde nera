                if data and "array" in data:
                    for biome in data["array"]:
                        if (biome_id := biome.get("id")) and biome_id not in biomes:
                            biomes.append(biome_id)
                return biomes
        return biomes

    def _organize_content_data(self):
        for file_data in self.content_pools.values():
            if isinstance(file_data, list):
                for pool in file_data:
                    if isinstance(pool, dict) and "name" in pool:
                        self.organized_content["Content Pools"][pool["name"]] = pool

        for file_data in self.content_lists.values():
            if isinstance(file_data, list):
                for content_list in file_data:
                    if isinstance(content_list, dict) and "name" in content_list:
                        list_name, category = (
                            content_list["name"],
                            self._categorize_content_list(content_list["name"]),
                        )
                        self.organized_content["Content Lists"][category][list_name] = content_list

    def _categorize_content_list(self, list_name: str) -> str:
        name_lower = list_name.lower()
        if "guarded" in name_lower:
            return "Guarded"
        if "unguarded" in name_lower:
            return "Unguarded"
        if any(w in name_lower for w in ["resource", "mine"]):
            return "Resources"
        if any(w in name_lower for w in ["building", "dwelling"]):
            return "Buildings"
        if any(w in name_lower for w in ["pickup", "item", "artifact"]):
            return "Pickups"
        return "Other"

