    def _load_data(self):
        """Load existing road config data into the form."""
        if self.road_config:
            # Set road type
            try:
                self.road_type_combo.setCurrentText(self.road_config.type)
            except:
                self.road_type_combo.setCurrentIndex(0)

            # Set from target
            if hasattr(self.road_config, "from_target") and self.road_config.from_target:
                self.from_type_combo.setCurrentText(self.road_config.from_target.type)
                self._populate_args_combo(self.from_args_combo, self.from_type_combo.currentText(), side="from")
                if self.road_config.from_target.args:
                    self.from_args_combo.setCurrentText(self.road_config.from_target.args[0])

            # Set to target
            if hasattr(self.road_config, "to_target") and self.road_config.to_target:
                self.to_type_combo.setCurrentText(self.road_config.to_target.type)
                self._populate_args_combo(self.to_args_combo, self.to_type_combo.currentText(), side="to")
                if self.road_config.to_target.args:
                    self.to_args_combo.setCurrentText(self.road_config.to_target.args[0])

        self.from_type_combo.currentTextChanged.connect(
            lambda _: self._populate_args_combo(self.from_args_combo, self.from_type_combo.currentText(), side="from")
        )
        self.to_type_combo.currentTextChanged.connect(
            lambda _: self._populate_args_combo(self.to_args_combo, self.to_type_combo.currentText(), side="to")
        )

    def _populate_args_combo(self, combo: ComboBox, target_type: str, side: str):
        combo.blockSignals(True)
        combo.clear()
        if target_type == RoadTargetType.MAIN_OBJECT.value:
            count = 0
            if self._zone_ctx and hasattr(self._zone_ctx, "main_objects"):
                count = len(self._zone_ctx.main_objects)
            options = [str(i) for i in range(count)]
            combo.addItems(options)
        elif target_type == RoadTargetType.CONNECTION.value:
            names = []
            for c in self._conn_ctx:
                name = getattr(c, "name", None)
                if name:
                    names.append(name)
            names = sorted(set(names))
            if names:
                combo.addItems(names)
        elif target_type == RoadTargetType.MANDATORY_CONTENT.value:
            items = []
            if self._zone_ctx and hasattr(self._zone_ctx, "mandatory_content"):
                items = list(self._zone_ctx.mandatory_content)
            if items:
                combo.addItems(items)
        else:
            pass
        combo.blockSignals(False)

    def _save_and_accept(self):
        """Save the form data to the road config and accept the dialog."""
        # Find the enum value that matches the text
        for road_type in RoadType:
            if road_type.value == self.road_type_combo.currentText():
                self.road_config.type = road_type
                break

        # Update from target
        if not hasattr(self.road_config, "from_target") or not self.road_config.from_target:
            from data.models import RoadTargetConfig

            self.road_config.from_target = RoadTargetConfig()

        self.road_config.from_target.type = self.from_type_combo.currentText()
        arg_val = self.from_args_combo.currentText().strip()
        self.road_config.from_target.args = [arg_val] if arg_val else []

        # Update to target
        if not hasattr(self.road_config, "to_target") or not self.road_config.to_target:
            from data.models import RoadTargetConfig

            self.road_config.to_target = RoadTargetConfig()

        self.road_config.to_target.type = self.to_type_combo.currentText()
        arg_val = self.to_args_combo.currentText().strip()
        self.road_config.to_target.args = [arg_val] if arg_val else []

        self.accept()


