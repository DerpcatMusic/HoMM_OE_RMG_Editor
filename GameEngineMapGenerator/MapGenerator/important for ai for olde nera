        invalid_value: str,
        enum_class: type[Enum],
        context: str = "",
    ):
        self.field_name = field_name
        self.invalid_value = invalid_value
        self.enum_class = enum_class
        self.context = context

        valid_values = [item.value for item in enum_class.__members__.values()]
        message = (
            f"Invalid enum value for {field_name}: '{invalid_value}'. "
            f"Valid values for {enum_class.__name__}: {valid_values}"
        )
        if context:
            message = f"{context}: {message}"

        super().__init__(message)


def validate_enum_field(
    field_name: str,
    value: str,
    enum_class: type[Enum],
    context: str = "",
    strict: bool = True,
) -> bool:
    """
    Validate an enum field value against its enum class.

    Args:
        field_name: Name of the field being validated
        value: String value to validate
        enum_class: Enum class to validate against
        context: Additional context for error messages
        strict: If True, raises EnumValidationError on failure

    Returns:
        True if valid, False if invalid (when strict=False)

    Raises:
        EnumValidationError: When strict=True and validation fails
    """
    if not value:  # Handle None or empty string
        if strict:
            raise EnumValidationError(field_name, str(value), enum_class, context)
        return False

    # Check if the enum class has a validate method, otherwise use standard membership check
    try:
        validate_method = getattr(enum_class, "validate", None)
        if validate_method and callable(validate_method):
            is_valid = bool(validate_method(value))
        else:
            # Fallback to standard enum validation
            enum_class(value)
            is_valid = True
    except (ValueError, TypeError, AttributeError):
        is_valid = False

    if not is_valid:
        if strict:
            raise EnumValidationError(field_name, value, enum_class, context)
        else:
            logger.warning(f"Invalid enum value: {field_name}='{value}' in {context}")
        return False

    return True


def get_enum_values(enum_class: type[Enum]) -> list[str]:
    """Get all valid string values from an enum class."""
    return [item.value for item in enum_class.__members__.values()]


def get_enum_names(enum_class: type[Enum]) -> list[str]:
    """Get all names from an enum class."""
    return [item.name for item in enum_class.__members__.values()]


def parse_enum_safe(enum_class: type[Enum], value: str, default=None):
    """Safely parse an enum value, returning default if invalid."""
    if not value:
        return default

    try:
        # Check if the enum class has a validate method
        validate_method = getattr(enum_class, "validate", None)
        if validate_method and callable(validate_method):
            if validate_method(value):
                return enum_class(value)
            else:
                return default
        else:
            # Use standard enum validation
            return enum_class(value)
    except (ValueError, AttributeError, TypeError):
        return default


def validate_enum_value(enum_class: type[Enum], value: str) -> bool:
    """Validate if a string value is valid for the given enum."""
    if not value:
        return False
    # Check if the enum class has a validate method
    try:
        validate_method = getattr(enum_class, "validate", None)
        if validate_method and callable(validate_method):
            return bool(validate_method(value))
        else:
            # Use standard enum validation
            enum_class(value)
            return True
    except (ValueError, TypeError, AttributeError):
        return False


