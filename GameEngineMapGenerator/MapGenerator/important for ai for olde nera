    def _update_values_section(self, pool_type: str):
        """Update the values section based on pool type."""
        # Disconnect all signals first to prevent issues during layout changes
        # Disconnect all signals first to prevent issues during layout changes
        # Note: We don't need to explicitly disconnect if we are about to destroy the widgets
        # and recreate them, which we do below. Explicit disconnects were causing
        # RuntimeWarning: Failed to disconnect (None) from signal "valueChanged(int)"

        # Clear all existing form items
        while self.values_layout.count():
            child = self.values_layout.takeAt(0)
            if child.widget():
                child.widget().deleteLater()

        # Recreate form layout
        self.values_form = QFormLayout()
        self.values_form.setContentsMargins(0, 10, 0, 0)
        self.values_layout.addLayout(self.values_form)

        # Always recreate spin boxes to avoid C++ deletion issues
        self.current_value_spin = SpinBox()
        self.current_value_spin.setRange(0, 999999)
        self.current_value_spin.setValue(0)

        self.current_value_per_area_spin = SpinBox()
        self.current_value_per_area_spin.setRange(0, 999999)
        self.current_value_per_area_spin.setValue(0)

        # Add appropriate value fields based on pool type
        if pool_type == "Guarded":
            self.values_form.addRow("Guarded Content Value:", self.current_value_spin)
            self.values_form.addRow("Guarded Value Per Area:", self.current_value_per_area_spin)
            # Connect to appropriate zone properties
            self.current_value_spin.valueChanged.connect(self._on_guarded_value_changed)
            self.current_value_per_area_spin.valueChanged.connect(self._on_guarded_value_per_area_changed)
        elif pool_type == "Unguarded":
            self.values_form.addRow("Unguarded Content Value:", self.current_value_spin)
            self.values_form.addRow("Unguarded Value Per Area:", self.current_value_per_area_spin)
            self.current_value_spin.valueChanged.connect(self._on_unguarded_value_changed)
            self.current_value_per_area_spin.valueChanged.connect(self._on_unguarded_value_per_area_changed)
        elif pool_type == "Resources":
            self.values_form.addRow("Resources Value:", self.current_value_spin)
            self.values_form.addRow("Resources Value Per Area:", self.current_value_per_area_spin)
            self.current_value_spin.valueChanged.connect(self._on_resources_value_changed)
            self.current_value_per_area_spin.valueChanged.connect(self._on_resources_value_per_area_changed)

        # Show the values group
        self.values_group.setVisible(True)

        # Load current values from zone
        self._load_current_values(pool_type)

    def _load_pool_items(self, pool_name: str, pool_type: str):
        """Load items for the selected pool."""
        self.pool_items_list.clear()

        if not self.current_zone:
            return

        # Get items from the appropriate zone property
        items = []
        if pool_type == "Guarded":
            items = self.current_zone.guarded_content_pool
        elif pool_type == "Unguarded":
            items = self.current_zone.unguarded_content_pool
        elif pool_type == "Resources":
            items = self.current_zone.resources_content_pool

        # Populate the list
        for item in items:
            list_item = ListWidgetItem(item)
            self.pool_items_list.addItem(list_item)

        # Enable remove button if there are items
        self.remove_from_pool_btn.setEnabled(len(items) > 0)

    def _load_current_values(self, pool_type: str):
        """Load current values from zone into the spin boxes."""
        if not self.current_zone:
            return

        # Safety check - ensure spin boxes exist and are valid
        try:
            if not hasattr(self, "current_value_spin") or not self.current_value_spin:
                return
            if not hasattr(self, "current_value_per_area_spin") or not self.current_value_per_area_spin:
                return
        except RuntimeError:
            # Widgets have been deleted by Qt
            return

        # Block signals to prevent recursive updates
        try:
            self.current_value_spin.blockSignals(True)
            self.current_value_per_area_spin.blockSignals(True)
        except RuntimeError:
            # Widgets have been deleted
            return

        if pool_type == "Guarded":
            self.current_value_spin.setValue(self.current_zone.guarded_content_value)
            self.current_value_per_area_spin.setValue(self.current_zone.guarded_content_value_per_area)
