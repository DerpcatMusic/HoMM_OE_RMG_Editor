    def _build_lookup_caches(self):
        """Build cached lookup structures for performance."""
        self.logger.info("Building lookup caches...")

        # Build biome lookups
        for sid, tile in self.tiles.items():
            self.biome_index_by_sid[sid] = tile.id
            self.biome_index_by_id[tile.id] = sid

        # Build water lookups
        if self.generator_settings:
            for biome_sid, water_sid in self.generator_settings.water_for_biome.items():
                if biome_sid in self.biome_index_by_sid and water_sid in self.waters:
                    biome_id = self.biome_index_by_sid[biome_sid]
                    water_id = self.waters[water_sid].id
                    self.water_id_by_biome_id[biome_id] = water_id

    def _organize_content_data(self):
        """Organize and cross-reference content data."""
        self.logger.info("Organizing content data...")

        # Build biomes info
        for sid, tile in self.tiles.items():
            associated_factions = [f.sid for f in self.factions.values() if f.biome == sid]

            self.biomes_info[sid] = {
                "name": tile.name,
                "id": tile.id,
                "fractions": associated_factions,
                "properties": tile.properties,
            }

    # Public API methods

    def get_map_object_desc(self, sid: str, variant: int = -1) -> MapObjectDesc | None:
        """
        Resolve an object SID and variant into a MapObjectDesc.

        Args:
            sid: Object SID
            variant: Specific variant (-1 for default)

        Returns:
            MapObjectDesc or None if not found
        """
        # Check meta-objects first
        if sid in self.meta_objects_by_sid:
            meta = self.meta_objects_by_sid[sid]
            return MapObjectDesc(sid=sid, variant=variant, properties=meta.properties)

        # Check regular objects
        if sid in self.objects and sid in self.obj_configs:
            obj_config = self.objects[sid]
            obj_base = self.obj_configs[sid]

            is_building = self.is_map_object_building_by_sid(sid)

            return MapObjectDesc(
                sid=sid,
                variant=variant,
                object_config=obj_config,
                obj_config_base=obj_base,
                is_building=is_building,
            )

        return None

    def get_map_object_desc_roll_specific(self, sid: str) -> MapObjectDesc | None:
        """
        Get MapObjectDesc with randomly selected variant based on rollChance.

        Args:
            sid: Object SID

        Returns:
            MapObjectDesc with specific variant or None
        """
        if sid in self.obj_configs:
            obj_base = self.obj_configs[sid]
            variants = obj_base.get_obj_variants()

            if variants:
                # Use weighted random selection
                weights = [v.roll_chance for v in variants]
                total_weight = sum(weights)

                if total_weight > 0:
                    import random

                    r = random.uniform(0, total_weight)
                    cumulative = 0
                    for i, weight in enumerate(weights):
                        cumulative += weight
                        if r <= cumulative:
                            return self.get_map_object_desc(sid, i)

        return self.get_map_object_desc(sid, 0)

    def is_map_object_building(self, desc: MapObjectDesc) -> bool:
        """
        Determine if a MapObjectDesc represents a building.

        Args:
            desc: MapObjectDesc to check

        Returns:
            True if the object is a building
        """
        if desc.object_config:
            return "Interact" in desc.object_config.tags
        return desc.is_building

    def is_map_object_building_by_sid(self, sid: str) -> bool:
        """
        Determine if an object SID represents a building.

        Args:
            sid: Object SID

        Returns:
            True if the object is a building
        """
        if sid in self.objects:
            return "Interact" in self.objects[sid].tags
        if sid in self.meta_objects_by_sid:
            return self.meta_objects_by_sid[sid].properties.get("isBuilding", False)
        return False

    def get_matching_guards(self, guard_value: int, can_be_main_guard: bool = True) -> list[SquadConfig]:
        """
        Get squads that match the guard value and role requirements.

        Args:
            guard_value: Required guard value
            can_be_main_guard: Whether squad can be a main guard

        Returns:
            List of matching SquadConfigs
        """
        matching_squads = []

        for squad in self.squads:
            if squad.min_squad_value <= guard_value <= squad.max_squad_value and (
                not can_be_main_guard or squad.can_be_main_guard
            ):
                matching_squads.append(squad)

        return matching_squads

