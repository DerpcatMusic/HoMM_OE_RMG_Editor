            self.zone_layout_preview.setText(summary)
        except Exception:
            self.zone_layout_preview.setText("")

    def _get_zone_layout_summary(self, name: str) -> str:
        if not name or not self.data_manager or not hasattr(self.data_manager, "zone_layouts"):
            return ""
        for file_data in self.data_manager.zone_layouts.values():
            candidates = []
            if isinstance(file_data, list):
                candidates = [x for x in file_data if isinstance(x, dict)]
            elif isinstance(file_data, dict):
                if "array" in file_data and isinstance(file_data["array"], list):
                    candidates = [x for x in file_data["array"] if isinstance(x, dict)]
                else:
                    candidates = [file_data]
            for obj in candidates:
                if obj.get("name") == name:
                    ofill = obj.get("obstaclesFill")
                    lakes = obj.get("lakesFill")
                    elev = obj.get("elevationClusterScale")
                    road = obj.get("roadClusterArea")
                    return f"obstaclesFill={ofill}, lakesFill={lakes}, elevationClusterScale={elev}, roadClusterArea={road}"
        return ""

