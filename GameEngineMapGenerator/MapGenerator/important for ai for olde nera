        layout.addWidget(label)

        self.faction_list = ListWidget()
        self.faction_list.setMaximumHeight(120)
        self.faction_list.setSelectionMode(ListWidget.SelectionMode.MultiSelection)

        # Populate with available factions
        if self.data_provider and hasattr(self.data_provider, "get_available_factions"):
            factions = self.data_provider.get_available_factions()
            for faction in factions:
                item = QListWidgetItem(faction)
                item.setCheckState(Qt.CheckState.Unchecked)
                self.faction_list.addItem(item)

        self.faction_list.itemChanged.connect(self._on_rule_changed)
        layout.addWidget(self.faction_list)

    def _create_match_zone_args(self, layout: QVBoxLayout):
        """Create arguments widget for MatchZone faction rule."""
        label = QLabel("Zone to match faction from:")
        layout.addWidget(label)

        self.zone_combo = ComboBox()
        self.zone_combo.setEditable(True)
        self.zone_combo.setPlaceholderText("Enter or select zone name")
        self.zone_combo.currentTextChanged.connect(self._on_rule_changed)
        layout.addWidget(self.zone_combo)

    def _create_match_biome_args(self, layout: QVBoxLayout):
        """Create arguments widget for MatchBiome faction rule."""
        label = QLabel("Biome to get faction from:")
        layout.addWidget(label)

        self.biome_combo = ComboBox()
        self.biome_combo.setEditable(True)
        if self.data_provider and hasattr(self.data_provider, "get_available_biomes"):
            biomes = self.data_provider.get_available_biomes()
            self.biome_combo.addItems(biomes)
        self.biome_combo.currentTextChanged.connect(self._on_rule_changed)
        layout.addWidget(self.biome_combo)

    def get_rule(self):
        """Get the current FactionRule object."""
        rule = FactionRule()
        if self.type_combo:
            rule.type = self.type_combo.currentText()
        rule.args = self._get_current_faction_args()
        return rule

    def set_rule(self, rule: FactionRule):
        """Set the FactionRule object."""
        if not rule:
            return

        # Set type
        if self.type_combo:
            index = self.type_combo.findText(rule.type)
            if index >= 0:
                self.type_combo.setCurrentIndex(index)

        # Set args
        self._set_current_faction_args(rule.args)

    def _get_current_faction_args(self) -> list[str]:
        """Get current arguments for faction rule."""
        if not self.type_combo:
            return []
        rule_type = self.type_combo.currentText()

        if rule_type == FactionRuleType.FROM_LIST.value and hasattr(self, "faction_list"):
            args = []
            for i in range(self.faction_list.count()):
                item = self.faction_list.item(i)
                if item.checkState() == Qt.CheckState.Checked:
                    args.append(item.text())
            return args
        elif rule_type == FactionRuleType.MATCH_ZONE.value and hasattr(self, "zone_combo"):
            text = self.zone_combo.currentText().strip()
            return [text] if text else []
        elif rule_type == FactionRuleType.MATCH_BIOME.value and hasattr(self, "biome_combo"):
            text = self.biome_combo.currentText().strip()
            return [text] if text else []

        return []

    def _set_current_faction_args(self, args: list[str]):
        """Set current arguments for faction rule."""
        if not args or not self.type_combo:
            return

        rule_type = self.type_combo.currentText()

        if rule_type == FactionRuleType.FROM_LIST.value and hasattr(self, "faction_list"):
            for i in range(self.faction_list.count()):
                item = self.faction_list.item(i)
                if item.text() in args:
                    item.setCheckState(Qt.CheckState.Checked)
                else:
                    item.setCheckState(Qt.CheckState.Unchecked)
        elif rule_type == FactionRuleType.MATCH_ZONE.value and hasattr(self, "zone_combo"):
            self.zone_combo.setCurrentText(args[0])
        elif rule_type == FactionRuleType.MATCH_BIOME.value and hasattr(self, "biome_combo"):
            self.biome_combo.setCurrentText(args[0])

    def _update_preview(self):
        """Update the preview text."""
        if not self.config.show_preview or not hasattr(self, "preview_label"):
            return

        rule = self.get_rule()
        preview_text = self._generate_faction_preview_text(rule)
        self.preview_label.setText(preview_text)

    def _generate_faction_preview_text(self, rule: FactionRule) -> str:
        """Generate human-readable preview text for a faction rule."""
        if not rule or not rule.type:
            return "No rule configured"

        if rule.type == FactionRuleType.FROM_LIST.value:
            if rule.args:
                factions = ", ".join(rule.args)
                return f"Randomly select from factions: {factions}"
            return "No factions selected"
        elif rule.type == FactionRuleType.MATCH_ZONE.value:
            if rule.args:
                return f"Use the same faction as zone: {rule.args[0]}"
            return "No zone specified"
        elif rule.type == FactionRuleType.MATCH_BIOME.value:
            if rule.args:
                return f"Use faction associated with biome: {rule.args[0]}"
            return "No biome specified"
        elif rule.type == FactionRuleType.RANDOM.value:
            return "Use a random faction from all available factions"
        else:
            return f"Rule type: {rule.type}"

    def validate_rule(self) -> tuple[bool, str]:
        """Validate the current faction rule."""
        rule = self.get_rule()

        if not validate_enum_value(FactionRuleType, rule.type):
            return False, f"Invalid rule type: {rule.type}"

        if rule.type == FactionRuleType.FROM_LIST.value:
            if not rule.args:
                return False, "FromList rule requires at least one faction"

        elif rule.type == FactionRuleType.MATCH_ZONE.value:
            if not rule.args:
                return False, "MatchZone rule requires a zone name"

        elif rule.type == FactionRuleType.MATCH_BIOME.value:
            if not rule.args:
                return False, "MatchBiome rule requires a biome SID"

        return True, ""


class RuleCollectionWidget(QWidget):
    """Widget for managing collections of rules (e.g., multiple placement rules)."""

    rules_changed = Signal(list)

    def __init__(self, rule_builder_class, title: str = "Rules", parent=None):
        super().__init__(parent)
        self.rule_builder_class = rule_builder_class
        self.title = title
        self.rules = []
        self.rule_widgets = []
        self.data_provider = None

        self.init_ui()
        self.setup_connections()

    def init_ui(self):
        """Initialize the rule collection interface."""
        layout = QVBoxLayout(self)

        # Header with title and add button
        header_layout = QHBoxLayout()
        title_label = QLabel(self.title)
        title_font = QFont()
        title_font.setBold(True)
        title_label.setFont(title_font)
        header_layout.addWidget(title_label)

        header_layout.addStretch()

        add_button = PushButton("Add Rule")
        add_button.clicked.connect(self.add_rule)
        header_layout.addWidget(add_button)

        layout.addLayout(header_layout)

        # Scrollable area for rules
        scroll_area = ScrollArea()
        scroll_area.setWidgetResizable(True)
        scroll_area.setMinimumHeight(200)

        self.rules_container = QWidget()
        self.rules_layout = QVBoxLayout(self.rules_container)
        self.rules_layout.addStretch()

        scroll_area.setWidget(self.rules_container)
        layout.addWidget(scroll_area)

    def setup_connections(self):
        """Setup signal connections."""
        pass

    def set_data_provider(self, provider):
        """Set data provider for all rule widgets."""
        self.data_provider = provider
        for widget in self.rule_widgets:
            if hasattr(widget, "set_data_provider"):
                widget.set_data_provider(provider)

    def add_rule(self, rule=None):
        """Add a new rule to the collection."""
        # Create rule widget
        rule_widget = self._create_rule_widget()
        if rule:
            rule_builder = getattr(rule_widget, "rule_builder", None)
            if rule_builder and hasattr(rule_builder, "set_rule"):
                rule_builder.set_rule(rule)

        # Add to layout (before stretch)
        self.rules_layout.insertWidget(self.rules_layout.count() - 1, rule_widget)
        self.rule_widgets.append(rule_widget)

        # Update rules list
        self._update_rules_list()

    def remove_rule(self, widget):
        """Remove a rule from the collection."""
        if widget in self.rule_widgets:
            self.rule_widgets.remove(widget)
            widget.deleteLater()
            self._update_rules_list()

    def _create_rule_widget(self) -> QWidget:
        """Create a single rule widget with controls."""
        container = QFrame()
        container.setFrameStyle(QFrame.Shape.StyledPanel)
        container.setFrameShadow(QFrame.Shadow.Raised)

        layout = QVBoxLayout(container)

        # Header with remove button
        header_layout = QHBoxLayout()
        header_layout.addStretch()

        remove_button = PushButton("Remove")
        remove_button.clicked.connect(lambda: self.remove_rule(container))
        remove_button.setMaximumWidth(80)
        header_layout.addWidget(remove_button)

        layout.addLayout(header_layout)

        # Rule builder
        rule_builder = self.rule_builder_class()
        if self.data_provider:
            rule_builder.set_data_provider(self.data_provider)
        rule_builder.rule_changed.connect(self._on_rule_changed)

        layout.addWidget(rule_builder)

        # Store rule builder reference
        container.rule_builder = rule_builder

        return container

    def _on_rule_changed(self):
        """Handle rule change in any widget."""
        self._update_rules_list()

    def _update_rules_list(self):
        """Update the internal rules list and emit signal."""
        self.rules = []
        for widget in self.rule_widgets:
            if hasattr(widget, "rule_builder"):
                rule = widget.rule_builder.get_rule()
                self.rules.append(rule)

        self.rules_changed.emit(self.rules)

    def set_rules(self, rules: list):
        """Set the complete list of rules."""
        # Clear existing rules
        for widget in self.rule_widgets[:]:
            self.remove_rule(widget)

        # Add new rules
        for rule in rules:
            if rule:
                self.add_rule(rule)

    def get_rules(self) -> list:
        """Get the current list of rules."""
        return self.rules

    def validate_all_rules(self) -> tuple[bool, list[str]]:
        """Validate all rules in the collection."""
        all_valid = True
        error_messages = []

        for i, widget in enumerate(self.rule_widgets):
            if hasattr(widget, "rule_builder"):
                is_valid, message = widget.rule_builder.validate_rule()
                if not is_valid:
                    all_valid = False
                    error_messages.append(f"Rule {i + 1}: {message}")

        return all_valid, error_messages


