    def _on_item_selection_changed(self, current, previous):
        """Handle selection change in the content tree."""
        if not current:
            self._clear_details()
            return

        content_data = current.data(0, Qt.UserRole)
        if not content_data:
            self._clear_details()
            return

        self._show_content_details(content_data)

    def _show_content_details(self, content_data: dict[str, Any]):
        """Show detailed information about the selected content."""
        content_type = content_data.get("type", "Unknown")
        content_id = content_data.get("id", "Unknown")
        data = content_data.get("data", {})

        self.details_title.setText(f"{content_type.title()} Details - {content_id}")
        self.current_content = content_data

        # Format details HTML
        details_html = f"<b>ID:</b> {content_id}<br>"
        details_html += f"<b>Type:</b> {content_type}<br><br>"

        if isinstance(data, dict):
            for key, value in data.items():
                if key in ["name", "description", "sid"]:
                    details_html += f"<b>{key.title()}:</b> {value}<br>"

            # Add more detailed information based on type
            if content_type == "biome":
                if "terrain_types" in data:
                    details_html += f"<b>Terrain Types:</b> {', '.join(data['terrain_types'])}<br>"
            elif content_type == "faction":
                if "alignment" in data:
                    details_html += f"<b>Alignment:</b> {data['alignment']}<br>"
                if "units" in data:
                    details_html += f"<b>Units:</b> {len(data['units'])} units<br>"
        else:
            details_html += f"<b>Data:</b> {str(data)}<br>"

        self.details_text.setHtml(details_html)

        # Enable action buttons
        self.insert_button.setEnabled(True)
        self.copy_id_button.setEnabled(True)

        # Emit selection signal
        self.content_selected.emit(content_type, content_data)

    def _clear_details(self):
        """Clear the details panel."""
        self.details_title.setText("Content Details")
        self.details_text.clear()
        self.insert_button.setEnabled(False)
        self.copy_id_button.setEnabled(False)
        self.current_content = None

    def _on_item_double_clicked(self, item, column):
        """Handle double-click on content item."""
        content_data = item.data(0, Qt.UserRole)
        if content_data:
            content_type = content_data.get("type", "Unknown")
            self.content_double_clicked.emit(content_type, content_data)

    def _on_search_changed(self, text):
        """Handle search text change."""
        # Simple implementation - hide/show items based on search text
        root = self.content_tree.invisibleRootItem()
        for i in range(root.childCount()):
            category_item = root.child(i)
            category_item.setHidden(False)  # Always show categories

            visible_children = 0
            for j in range(category_item.childCount()):
                child_item = category_item.child(j)
                item_text = child_item.text(0).lower()
                item_id = child_item.text(2).lower()

                if not text or text.lower() in item_text or text.lower() in item_id:
                    child_item.setHidden(False)
                    visible_children += 1
                else:
                    child_item.setHidden(True)

            # Hide category if no children are visible and we have a search term
            if text and visible_children == 0:
                category_item.setHidden(True)

    def _on_category_changed(self, category_text):
        """Handle category filter change."""
        selected_category = self.category_combo.currentData()

        root = self.content_tree.invisibleRootItem()
        for i in range(root.childCount()):
            category_item = root.child(i)
            category_name = category_item.text(0).lower()

            if selected_category == "all":
                category_item.setHidden(False)
            else:
                # Map combo box values to category names
                show_category = False
                if (
                    selected_category == "biomes"
                    and "biome" in category_name
                    or selected_category == "factions"
                    and "faction" in category_name
                    or selected_category == "objects"
                    and "object" in category_name
                    or selected_category == "content_pools"
                    and "pool" in category_name
                    or selected_category == "content_lists"
                    and "list" in category_name
                ):
                    show_category = True

                category_item.setHidden(not show_category)

    def _on_insert_clicked(self):
        """Handle insert button click."""
        if self.current_content:
            content_type = self.current_content.get("type", "Unknown")
            self.content_double_clicked.emit(content_type, self.current_content)

    def _on_copy_id_clicked(self):
        """Handle copy ID button click."""
        if self.current_content:
            from PySide6.QtGui import QGuiApplication

            content_id = self.current_content.get("id", "")
            QGuiApplication.clipboard().setText(content_id)

    def refresh_content(self):
        """Refresh the content tree with updated data."""
        self._populate_content_tree()

    def get_selected_content(self) -> dict[str, Any] | None:
        """Get the currently selected content."""
        return self.current_content

    def select_content_by_id(self, content_id: str):
        """Select content by its ID."""
        root = self.content_tree.invisibleRootItem()
        for i in range(root.childCount()):
            category_item = root.child(i)
            for j in range(category_item.childCount()):
                child_item = category_item.child(j)
                if child_item.text(2) == content_id:
                    self.content_tree.setCurrentItem(child_item)
                    category_item.setExpanded(True)
                    return True
        return False
