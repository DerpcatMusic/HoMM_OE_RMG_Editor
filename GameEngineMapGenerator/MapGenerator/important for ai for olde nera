class PlacementRule(RMG_BaseModel):
    """A rule for placing content spatially - updated to match C# MapDescription.PlacementRule structure."""

    type: PlacementRuleType = PlacementRuleType.RANDOM
    args: list[str] | None = None
    target: float = 0.5
    target_min: float = Field(default=0.0, alias="targetMin")
    target_max: float = Field(default=0.0, alias="targetMax")
    weight: float = 1.0

    # Additional fields from C# MapDescription.PlacementRule struct
    sid: str | None = None  # Content SID for placement
    main_object_index: int = Field(default=-1, alias="mainObjectIndex")  # Index of main object
    connection_index: int = Field(default=-1, alias="connectionIndex")  # Index of connection
    mandatory_content_index: int = Field(default=-1, alias="mandatoryContentIndex")  # Index of mandatory content

    @field_validator("type", mode="before")
    def convert_type(cls, v):
        if isinstance(v, str):
            return PlacementRuleType(v)
        return v

    @field_validator("target", "target_min", "target_max")
    @classmethod
    def validate_target_values(cls, v):
        """Validate target values are between 0.0 and 1.0."""
        if not 0.0 <= v <= 1.0:
            raise ValueError(f"Target values must be between 0.0 and 1.0, got {v}")
        return v

    @field_validator("weight")
    @classmethod
    def validate_weight(cls, v):
        """Validate weight is non-negative."""
        if v < 0.0:
            raise ValueError(f"Weight must be non-negative, got {v}")
        return v

    @classmethod
    def model_validate(cls, obj, *, strict=None, from_attributes=None, context=None):
        """Override model_validate to extract indices from args before validation."""
        if isinstance(obj, dict):
            obj = obj.copy()  # Don't modify the original

            # Extract indices from args for specific types
            rule_type = obj.get("type")
            args = obj.get("args", [])

            if rule_type in ("MainObject", PlacementRuleType.MAIN_OBJECT) and args and len(args) > 0:
                try:
                    if obj.get("main_object_index", -1) < 0:
                        obj["main_object_index"] = int(args[0])
                except (ValueError, TypeError):
                    pass

            elif rule_type in ("Connection", PlacementRuleType.CONNECTION) and args and len(args) > 0:
                try:
                    if obj.get("connection_index", -1) < 0:
                        obj["connection_index"] = int(args[0])
                except (ValueError, TypeError):
                    pass

            elif rule_type in ("MandatoryContent", PlacementRuleType.MANDATORY_CONTENT) and args and len(args) > 0:
                try:
                    if obj.get("mandatory_content_index", -1) < 0:
                        obj["mandatory_content_index"] = int(args[0])
                except (ValueError, TypeError):
                    pass

            elif rule_type in ("Sid", PlacementRuleType.SID) and args and len(args) > 0:
                if not obj.get("sid"):
                    obj["sid"] = args[0]

        return super().model_validate(obj, strict=strict, from_attributes=from_attributes, context=context)

    @model_validator(mode="after")
    def validate_placement_rule_constraints(self):
        """Validate placement rule constraints based on C# logic."""
        # Basic range validation for target_min and target_max
        if self.target_min > self.target_max:
            raise ValueError(f"target_min ({self.target_min}) cannot be greater than target_max ({self.target_max})")

        # Type-specific validation - more lenient for template compatibility
        if self.type == PlacementRuleType.MAIN_OBJECT:
            # Try to extract from args if not set
            if self.main_object_index < 0 and self.args and len(self.args) > 0:
                try:
                    self.main_object_index = int(self.args[0])
                except (ValueError, TypeError):
                    pass
            # Only validate if we still don't have a valid index and args are empty
            if self.main_object_index < 0 and (not self.args or len(self.args) == 0):
                raise ValueError("PlacementRule with type 'MainObject' must have a valid main_object_index or args")

        elif self.type == PlacementRuleType.CONNECTION:
            if self.connection_index < 0 and (not self.args or len(self.args) == 0):
                raise ValueError("PlacementRule with type 'Connection' must have a valid connection_index or args")

        elif self.type == PlacementRuleType.MANDATORY_CONTENT:
            if self.mandatory_content_index < 0 and (not self.args or len(self.args) == 0):
                raise ValueError(
                    "PlacementRule with type 'MandatoryContent' must have a valid mandatory_content_index or args"
                )

        elif self.type == PlacementRuleType.SID:
            # Try to extract from args if not set
            if not self.sid and self.args and len(self.args) > 0:
                self.sid = self.args[0]
            # Only validate if we still don't have a SID and args are empty
            if not self.sid and (not self.args or len(self.args) == 0):
                raise ValueError("PlacementRule with type 'Sid' must have a sid value or args")

        return self

    def get_display_summary(self) -> str:
        """Get a user-friendly display summary of this placement rule."""
        base = f"{self.type.value} (target: {self.target:.2f}, weight: {self.weight:.2f})"

        if self.sid:
            base += f" [SID: {self.sid}]"

        if self.args:
            args_str = ", ".join(self.args)
            base += f" [Args: {args_str}]"

        return base


