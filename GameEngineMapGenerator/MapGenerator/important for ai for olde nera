        # Create display names with both type and description
        object_options = []
        for obj_type in MainObjectType:
            display_name = f"{obj_type.value} - {obj_type.value}"  # Can be enhanced with descriptions
            object_options.append(display_name)

        obj_choice, ok = QInputDialog.getItem(self, "Add Main Object", "Select object type:", object_options, 0, False)

        if ok:
            # Extract the actual type from the display choice
            obj_type_value = obj_choice.split(" - ")[0]

            # Create new main object with defaults
            from data.models import MainObject

            new_object = MainObject()
            # Find the enum value that matches the text
            for main_obj_type in MainObjectType:
                if main_obj_type.value == obj_type_value:
