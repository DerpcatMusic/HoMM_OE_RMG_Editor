    def _generate_preview_text(self, rule: PlacementRule) -> str:
        """Generate human-readable preview text for a placement rule."""
        if not rule or not rule.type:
            return "No rule configured"

        distance_desc = ""
        if rule.target_min > 0 or rule.target_max < 1.0:
            distance_desc = f" at distance {rule.target_min:.1f}-{rule.target_max:.1f}"
        else:
            distance_desc = f" at distance {rule.target:.1f}"

        weight_desc = f" (weight: {rule.weight:.1f})" if rule.weight != 1.0 else ""

        if rule.type == PlacementRuleType.RANDOM.value:
            return f"Place randomly{weight_desc}"
        elif rule.type == PlacementRuleType.MAIN_OBJECT.value:
            if rule.args:
                return f"Place{distance_desc} from main object {rule.args[0]}{weight_desc}"
            return f"Place{distance_desc} from main object{weight_desc}"
        elif rule.type == PlacementRuleType.CROSSROADS.value:
            return f"Place{distance_desc} from crossroads{weight_desc}"
        elif rule.type == PlacementRuleType.CONNECTION.value:
            if rule.args:
                return f"Place{distance_desc} from connection '{rule.args[0]}'{weight_desc}"
            return f"Place{distance_desc} from connection{weight_desc}"
        elif rule.type == PlacementRuleType.ROAD.value:
            return f"Place{distance_desc} from roads{weight_desc}"
        elif rule.type == PlacementRuleType.MANDATORY_CONTENT.value:
            if rule.args:
                return f"Place{distance_desc} from mandatory content '{rule.args[0]}'{weight_desc}"
            return f"Place{distance_desc} from mandatory content{weight_desc}"
        elif rule.type == PlacementRuleType.SID.value:
            if rule.args:
                return f"Place{distance_desc} from objects with SID '{rule.args[0]}'{weight_desc}"
            return f"Place{distance_desc} from SID{weight_desc}"
        else:
            return f"Place using {rule.type} rule{distance_desc}{weight_desc}"

    def get_rule(self) -> PlacementRule:
        """Get the current PlacementRule object."""
        rule = PlacementRule()
        if self.type_combo:
            rule.type = self.type_combo.currentText()
        rule.args = self._get_current_placement_args()
        if self.weight_spin:
            rule.weight = self.weight_spin.value()

        if self.use_range_checkbox and self.use_range_checkbox.isChecked():
            if self.target_min_spin:
                rule.target_min = self.target_min_spin.value()
            if self.target_max_spin:
                rule.target_max = self.target_max_spin.value()
            rule.target = 0.5  # Default when using range
        else:
            if self.target_spin:
                rule.target = self.target_spin.value()
            rule.target_min = 0.0
            rule.target_max = 0.0

        return rule

    def set_rule(self, rule: PlacementRule):
        """Set the PlacementRule object."""
        if not rule:
            return

        # Set type
        if self.type_combo:
            index = self.type_combo.findText(rule.type)
            if index >= 0:
                self.type_combo.setCurrentIndex(index)

        # Set weight
        if self.weight_spin:
            self.weight_spin.setValue(rule.weight)

        # Set target/range
        if rule.target_min > 0 or rule.target_max < 1.0:
            if self.use_range_checkbox:
                self.use_range_checkbox.setChecked(True)
            if self.target_min_spin:
                self.target_min_spin.setValue(rule.target_min)
            if self.target_max_spin:
                self.target_max_spin.setValue(rule.target_max)
        else:
            if self.use_range_checkbox:
                self.use_range_checkbox.setChecked(False)
            if self.target_spin:
                self.target_spin.setValue(rule.target)

        # Set args
        self._set_current_placement_args(rule.args)

    def _get_current_placement_args(self) -> list[str]:
        """Get current arguments for placement rule."""
        if not self.type_combo:
            return []
        rule_type = self.type_combo.currentText()

        if rule_type == PlacementRuleType.MAIN_OBJECT.value and hasattr(self, "main_object_index"):
            return [str(self.main_object_index.value())]
        elif rule_type == PlacementRuleType.CONNECTION.value and hasattr(self, "connection_combo"):
            text = self.connection_combo.currentText().strip()
            return [text] if text else []
        elif rule_type == PlacementRuleType.MANDATORY_CONTENT.value and hasattr(self, "content_name_edit"):
            text = self.content_name_edit.text().strip()
            return [text] if text else []
        elif rule_type == PlacementRuleType.SID.value and hasattr(self, "sid_combo"):
            text = self.sid_combo.currentText().strip()
            return [text] if text else []

        return []

    def _set_current_placement_args(self, args: list[str]):
        """Set current arguments for placement rule."""
        if not args or not self.type_combo:
            return

        rule_type = self.type_combo.currentText()

        if rule_type == PlacementRuleType.MAIN_OBJECT.value and hasattr(self, "main_object_index"):
            try:
                self.main_object_index.setValue(int(args[0]))
            except (ValueError, IndexError):
                pass
        elif rule_type == PlacementRuleType.CONNECTION.value and hasattr(self, "connection_combo"):
            self.connection_combo.setCurrentText(args[0])
        elif rule_type == PlacementRuleType.MANDATORY_CONTENT.value and hasattr(self, "content_name_edit"):
            self.content_name_edit.setText(args[0])
        elif rule_type == PlacementRuleType.SID.value and hasattr(self, "sid_combo"):
            self.sid_combo.setCurrentText(args[0])

    def validate_rule(self) -> tuple[bool, str]:
        """Validate the current placement rule."""
        rule = self.get_rule()

        if not validate_enum_value(PlacementRuleType, rule.type):
            return False, f"Invalid rule type: {rule.type}"

        if rule.weight <= 0:
            return False, "Weight must be positive"

        if rule.target < 0 or rule.target > 1:
            return False, "Target must be between 0.0 and 1.0"

        if rule.target_min < 0 or rule.target_min > 1:
            return False, "Target min must be between 0.0 and 1.0"

        if rule.target_max < 0 or rule.target_max > 1:
            return False, "Target max must be between 0.0 and 1.0"

        if rule.target_min > rule.target_max:
            return False, "Target min cannot be greater than target max"

        # Type-specific validation
        if rule.type == PlacementRuleType.MAIN_OBJECT.value:
            if not rule.args:
                return False, "MainObject rule requires a main object index"
            try:
                int(rule.args[0])
            except (ValueError, IndexError):
                return False, "Main object index must be a number"

        elif rule.type == PlacementRuleType.CONNECTION.value:
            if not rule.args:
                return False, "Connection rule requires a connection name"

        elif rule.type == PlacementRuleType.MANDATORY_CONTENT.value:
            if not rule.args:
                return False, "MandatoryContent rule requires a content name"

        elif rule.type == PlacementRuleType.SID.value:
            if not rule.args:
                return False, "SID rule requires a content SID"

        return True, ""


