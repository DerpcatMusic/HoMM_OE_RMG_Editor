    def cleanup(self):
        """Clean up resources and clear caches."""
        self.tiles.clear()
        self.objects.clear()
        self.obj_configs.clear()
        self.waters.clear()
        self.factions.clear()
        self.squads.clear()
        self.encounter_templates.clear()
        self.zone_layouts.clear()
        self.content_pools.clear()
        self.content_lists.clear()
        self.meta_objects_by_sid.clear()
        self.biome_index_by_sid.clear()
        self.biome_index_by_id.clear()
        self.water_id_by_biome_id.clear()
        self.available_factions.clear()
        self.biomes_info.clear()
        self.is_loaded = False
