            self.current_value_spin.setValue(self.current_zone.resources_value)
            self.current_value_per_area_spin.setValue(self.current_zone.resources_value_per_area)

        # Re-enable signals
        try:
            self.current_value_spin.blockSignals(False)
            self.current_value_per_area_spin.blockSignals(False)
        except RuntimeError:
