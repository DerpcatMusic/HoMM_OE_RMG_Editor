    def _update_biome_rule_from_ui(self, rule_type: str) -> None:
        """Update biome rule from UI state."""
        if not self.current_zone or self._updating:
            return

        # Get the appropriate biome rule and UI elements
        if rule_type == "zone":
            biome_rule = self.current_zone.zone_biome
            type_combo = self.zone_biome_type_combo
            biome_list = self.zone_biome_list
            object_combo = self.zone_biome_object_combo
            different_object_spin = self.zone_biome_different_object_spin
            different_zone_combo = self.zone_biome_different_zone_combo
        elif rule_type == "content":
            biome_rule = self.current_zone.content_biome
            type_combo = self.content_biome_type_combo
            biome_list = self.content_biome_list
            object_combo = self.content_biome_object_combo
            different_object_spin = self.content_biome_different_object_spin
            different_zone_combo = self.content_biome_different_zone_combo
        elif rule_type == "meta_objects":
            biome_rule = self.current_zone.meta_objects_biome
            type_combo = self.meta_objects_biome_type_combo
            biome_list = self.meta_objects_biome_list
            object_combo = self.meta_objects_biome_object_combo
            different_object_spin = self.meta_biome_different_object_spin
            different_zone_combo = self.meta_biome_different_zone_combo
        else:
            return

        if not biome_rule:
            return

        # Update the biome rule based on UI state
        for biome_type in BiomeRuleType:
            if biome_type.value == type_combo.currentText():
                biome_rule.type = biome_type
                break

        # Update args based on rule type
        if biome_rule.type == BiomeRuleType.FROM_LIST:
            # Get selected biomes
            selected_biomes = []
            for i in range(biome_list.count()):
                item = biome_list.item(i)
                if item.isSelected():
                    selected_biomes.append(item.text())
            biome_rule.args = selected_biomes
        elif biome_rule.type == BiomeRuleType.MATCH_MAIN_OBJECT:
            # Get main object selection by index
            current_data = object_combo.currentData()
            biome_rule.args = [current_data] if current_data else []
        elif biome_rule.type == BiomeRuleType.DIFFERENT_FROM:
            # Get different from reference
            object_index = different_object_spin.value()
            zone_name = different_zone_combo.currentText()
            if zone_name:
                different_from_ref = f"differentFrom: {object_index} {zone_name}"
                biome_rule.args = [different_from_ref]
            else:
                biome_rule.args = []
        else:
            # MatchZone needs no arguments
            biome_rule.args = []

        self.zone_changed.emit()

