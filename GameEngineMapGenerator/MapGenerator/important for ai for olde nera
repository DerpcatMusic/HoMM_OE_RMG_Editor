"""
Game Data Access Layer for RMG Editor

Provides access to Heroes of Might & Magic Olden Era game data including biomes,
factions, and helper functions for the UI behavioral specification.
"""

import json
import logging
import os
from pathlib import Path
from typing import Any

logger = logging.getLogger(__name__)


class GameDataLoader:
    """
    Centralized access to Heroes OE game data files.
    Loads and caches biome information, faction data, and provides
    helper functions for the rule builder UI components.
    """

    def __init__(self, heroes_data_path: str | None = None):
        """
        Initialize the game data loader.

        Args:
            heroes_data_path: Path to the HeroesOE_Data directory.
                            If None, attempts to auto-detect.
        """
        if heroes_data_path is None:
            # Auto-detect path - look for common installation locations
            possible_paths = [
                r"C:\Program Files (x86)\Steam\steamapps\common\Heroes of Might & Magic Olden Era Playtest\HeroesOE_Data",
                r"C:\Program Files\Steam\steamapps\common\Heroes of Might & Magic Olden Era Playtest\HeroesOE_Data",
                # Add more common paths as needed
            ]

            heroes_data_path = None
            for path in possible_paths:
                if os.path.exists(path):
                    heroes_data_path = path
                    break

            if heroes_data_path is None:
                raise FileNotFoundError("Could not find HeroesOE_Data directory. Please specify the path manually.")

        self.heroes_data_path = Path(heroes_data_path)
        sa_root = self.heroes_data_path / "StreamingAssets"
        core_db = sa_root / "Core" / "DB"
        flat_db = sa_root / "DB"
        if core_db.exists():
            self.streaming_assets_path = core_db
        elif flat_db.exists():
            self.streaming_assets_path = flat_db
        else:
            self.streaming_assets_path = core_db
            logger.warning(f"Could not locate DB under {core_db} or {flat_db}. Using default {core_db}.")

        # Cached data
        self._biomes_info = None
        self._factions_data = None
        self._biome_faction_mapping = None
        self._buildings_constructions = None
        self._buildings_bans = None
        self._all_building_sids = None

        logger.info(f"GameDataLoader initialized with path: {self.heroes_data_path}")

    def _load_biomes_info(self) -> dict[str, Any]:
        """Load biomes_info.json file."""
        if self._biomes_info is None:
            biomes_path = self.streaming_assets_path / "biomes_info.json"
            logger.info(f"Attempting to load biomes from: {biomes_path}")

            if not biomes_path.exists():
                logger.error(f"biomes_info.json not found at: {biomes_path}")
                self._biomes_info = {}
                return self._biomes_info

            try:
                with open(biomes_path, encoding="utf-8-sig") as f:
                    self._biomes_info = json.load(f)
                logger.info(f"Successfully loaded biomes_info.json with keys: {list(self._biomes_info.keys())}")
            except Exception as e:
                logger.error(f"Failed to load biomes_info.json: {e}")
                self._biomes_info = {}

        return self._biomes_info

    def _load_factions_data(self) -> dict[str, Any]:
        """
        Load faction data. This might come from data.json or another file.
        For now, we'll extract it from biomes_info and add common factions.
        """
        if self._factions_data is None:
            # Start with factions from biomes_info
            biomes_info = self._load_biomes_info()
            factions = set()

            fractions_by_biome = biomes_info.get("fractionsByBiome", {}).get("data", [])
            for entry in fractions_by_biome:
                factions.add(entry.get("val", ""))

            # Add additional common factions that might not be in biomes
            additional_factions = ["neutral", "random"]  # Add more as needed
            factions.update(additional_factions)

            # Remove empty strings
            factions.discard("")

            self._factions_data = {"available_factions": sorted(list(factions))}

            logger.info(f"Loaded factions: {self._factions_data['available_factions']}")

        return self._factions_data

    def _load_buildings_constructions(self) -> dict[str, list[str]]:
        """Load building construction presets from buildings_constructions folder."""
        if self._buildings_constructions is None:
            constructions_path = self.streaming_assets_path / "buildings_constructions"
            self._buildings_constructions = {}

            if not constructions_path.exists():
                logger.error(f"buildings_constructions folder not found at: {constructions_path}")
                return self._buildings_constructions

            try:
                # Load all construction preset files
                for json_file in constructions_path.glob("*.json"):
                    try:
                        with open(json_file, encoding="utf-8-sig") as f:
                            data = json.load(f)

                        # Extract construction presets
                        if "array" in data:
                            for preset in data["array"]:
                                preset_id = preset.get("id", "")
                                if preset_id:
                                    self._buildings_constructions[preset_id] = preset_id

                    except Exception as e:
                        logger.warning(f"Failed to load construction file {json_file}: {e}")

                logger.info(f"Loaded {len(self._buildings_constructions)} building construction presets")

            except Exception as e:
                logger.error(f"Failed to load building constructions: {e}")

        return self._buildings_constructions

    def _load_buildings_bans(self) -> dict[str, list[str]]:
        """Load building ban lists from buildings_bans folder."""
        if self._buildings_bans is None:
            bans_path = self.streaming_assets_path / "buildings_bans"
            self._buildings_bans = {}

            if not bans_path.exists():
                logger.error(f"buildings_bans folder not found at: {bans_path}")
                return self._buildings_bans

            try:
                # Load all ban list files
                for json_file in bans_path.glob("*.json"):
                    try:
                        with open(json_file, encoding="utf-8-sig") as f:
                            data = json.load(f)

                        # Extract ban list presets
                        if "array" in data:
                            for preset in data["array"]:
                                preset_id = preset.get("id", "")
                                if preset_id:
                                    self._buildings_bans[preset_id] = preset_id

                    except Exception as e:
                        logger.warning(f"Failed to load ban file {json_file}: {e}")

                logger.info(f"Loaded {len(self._buildings_bans)} building ban presets")

            except Exception as e:
                logger.error(f"Failed to load building bans: {e}")

        return self._buildings_bans

    def _load_all_building_sids(self) -> list[str]:
        """Load all unique building SIDs from construction and ban files."""
        if self._all_building_sids is None:
            building_sids = set()

            # Load from constructions
            constructions_path = self.streaming_assets_path / "buildings_constructions"
            if constructions_path.exists():
                for json_file in constructions_path.glob("*.json"):
                    try:
                        with open(json_file, encoding="utf-8-sig") as f:
                            data = json.load(f)

                        if "array" in data:
                            for preset in data["array"]:
                                buildings = preset.get("buildings", [])
                                for building in buildings:
                                    sid = building.get("sid", "")
                                    if sid:
                                        building_sids.add(sid)

                    except Exception as e:
                        logger.warning(f"Failed to extract building SIDs from {json_file}: {e}")

            # Load from bans
            bans_path = self.streaming_assets_path / "buildings_bans"
            if bans_path.exists():
                for json_file in bans_path.glob("*.json"):
                    try:
                        with open(json_file, encoding="utf-8-sig") as f:
                            data = json.load(f)

                        if "array" in data:
                            for preset in data["array"]:
                                buildings = preset.get("buildings", [])
                                for building in buildings:
                                    sid = building.get("sid", "")
                                    if sid:
                                        building_sids.add(sid)

                    except Exception as e:
                        logger.warning(f"Failed to extract building SIDs from {json_file}: {e}")

            self._all_building_sids = sorted(list(building_sids))
            logger.info(f"Found {len(self._all_building_sids)} unique building SIDs")

        return self._all_building_sids

    def get_biome_sids(self) -> list[str]:
        """
        Get list of available biome SIDs for the FromList UI component.

        Returns:
            List of biome SIDs like ["Grass", "Deathland", "Dirt", "Lava", "Sand"]
        """
        biomes_info = self._load_biomes_info()
        logger.info(f"Biomes info loaded: {biomes_info}")

        if not biomes_info:
            logger.warning("No biomes_info loaded, returning fallback biomes")
            return ["Grass", "Deathland", "Dirt", "Lava", "Sand", "Ice", "Autumn"]

        fractions_by_biome = biomes_info.get("fractionsByBiome", {}).get("data", [])
        logger.info(f"Fractions by biome data: {fractions_by_biome}")

        biomes = []
        for entry in fractions_by_biome:
            biome_key = entry.get("key", "")
            if biome_key:
                biomes.append(biome_key)

        logger.info(f"Extracted biomes: {biomes}")
        return sorted(biomes) if biomes else ["Grass", "Deathland", "Dirt", "Lava", "Sand", "Ice", "Autumn"]

    def get_faction_sids(self) -> list[str]:
        """
        Get list of available faction SIDs for the FromList UI component.

        Returns:
            List of faction SIDs like ["human", "undead", "dungeon", "demon", "neutral"]
        """
        factions_data = self._load_factions_data()
        factions = factions_data.get("available_factions", [])

        logger.debug(f"Available factions: {factions}")
        return factions

    def get_biome_faction_mapping(self) -> dict[str, str]:
        """
        Get mapping of biomes to their associated factions.

        Returns:
            Dictionary mapping biome -> faction, e.g., {"Grass": "human", "Deathland": "undead"}
        """
        if self._biome_faction_mapping is None:
            biomes_info = self._load_biomes_info()
            fractions_by_biome = biomes_info.get("fractionsByBiome", {}).get("data", [])

            mapping = {}
            for entry in fractions_by_biome:
                biome_key = entry.get("key", "")
                faction_val = entry.get("val", "")
                if biome_key and faction_val:
                    mapping[biome_key] = faction_val

            self._biome_faction_mapping = mapping
            logger.debug(f"Biome->Faction mapping: {mapping}")

        return self._biome_faction_mapping

    def get_faction_for_biome(self, biome: str) -> str | None:
        """
        Get the faction associated with a specific biome.

        Args:
            biome: Biome SID like "Grass"

