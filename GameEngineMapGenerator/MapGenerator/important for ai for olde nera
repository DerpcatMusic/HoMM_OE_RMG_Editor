    def _on_data_changed(self):
        """Handle data changes."""
        if self._updating or not self.current_object:
            return

        self._update_object_from_ui()
        self.objectChanged.emit(self.current_object)

    def _update_object_from_ui(self):
        """Update the current object from UI values."""
        if not self.current_object:
            return

        # Basic settings - handle enum conversion safely
        type_text = self.type_combo.currentText()
        try:
            self.current_object.type = MainObjectType(type_text)
        except ValueError:
            # Fallback to finding by value
            for obj_type in MainObjectType:
                if obj_type.value == type_text:
                    self.current_object.type = obj_type
                    break
            else:
                self.current_object.type = MainObjectType.CITY  # Default fallback

        placement_text = self.placement_combo.currentText()
        try:
            self.current_object.placement = MainObjectPlacement(placement_text)
        except ValueError:
            # Fallback to finding by value
            for placement_type in MainObjectPlacement:
                if placement_type.value == placement_text:
                    self.current_object.placement = placement_type
                    break
            else:
                self.current_object.placement = MainObjectPlacement.UNIFORM  # Default fallback

        # Placement args
        args = []
        for i in range(self.placement_args_list.count()):
            item = self.placement_args_list.item(i)
            args.append(item.text())
        self.current_object.placement_args = args

        # Spawn and owner
        spawn_data = self.spawn_combo.currentData()
        self.current_object.spawn = spawn_data if spawn_data else None

        owner_data = self.owner_combo.currentData()
        self.current_object.owner = owner_data if owner_data else None

        self.current_object.is_key_object = self.key_object_check.isChecked()

        # Faction
        if hasattr(self.faction_widget, "get_faction_rule"):
            self.current_object.faction = self.faction_widget.get_faction_rule()

        # Guard settings
        guard_widget = self.guard_widget
        self.current_object.guard_chance = guard_widget.guard_chance_spin.value()
        self.current_object.guard_value = guard_widget.guard_value_spin.value()
        self.current_object.guard_weekly_increment = guard_widget.guard_weekly_spin.value()
        self.current_object.guard_randomization = guard_widget.guard_randomization_spin.value()
        self.current_object.remove_guard_if_has_owner = guard_widget.remove_guard_check.isChecked()

        # Building settings
        building_widget = self.building_widget
        construction_sid = building_widget.get_construction_sid()
        ban_sid = building_widget.get_ban_sid()

        self.current_object.buildings_construction_sid = construction_sid if construction_sid else None
        self.current_object.buildings_ban_sid = ban_sid if ban_sid else None

        logger.debug(f"Updated building settings - Construction: {construction_sid}, Ban: {ban_sid}")

        # Advanced settings
        self.current_object.enable_weekly_unit_increment = self.enable_weekly_increment_check.isChecked()
        self.current_object.initial_unit_increment = self.initial_increment_spin.value()

    def set_main_object(self, main_object: MainObject):
        """Set the main object to edit."""
        self._updating = True
        try:
            self.current_object = main_object

            # Update basic settings
            # Handle both enum and string values for type
            type_text = (
                main_object.type.value
                if hasattr(main_object.type, "value")
                else str(main_object.type)
                if main_object.type
                else "City"
            )
            type_index = self.type_combo.findText(type_text)
            if type_index >= 0:
                self.type_combo.setCurrentIndex(type_index)

            # Handle both enum and string values for placement
            placement_text = (
                main_object.placement.value
                if hasattr(main_object.placement, "value")
                else str(main_object.placement)
                if main_object.placement
                else "Uniform"
            )
            placement_index = self.placement_combo.findText(placement_text)
            if placement_index >= 0:
                self.placement_combo.setCurrentIndex(placement_index)

            # Placement arguments
            self.placement_args_list.clear()
            if main_object.placement_args:
                for arg in main_object.placement_args:
                    item = QListWidgetItem(str(arg))
                    self.placement_args_list.addItem(item)

            # Spawn and owner
            spawn_index = self.spawn_combo.findData(main_object.spawn)
            if spawn_index >= 0:
                self.spawn_combo.setCurrentIndex(spawn_index)

            owner_index = self.owner_combo.findData(main_object.owner)
            if owner_index >= 0:
                self.owner_combo.setCurrentIndex(owner_index)

            self.key_object_check.setChecked(main_object.is_key_object)

            # Faction
            if (
                main_object.faction
                and isinstance(main_object.faction, FactionRule)
                and hasattr(self.faction_widget, "set_faction_rule")
            ):
                self.faction_widget.set_faction_rule(main_object.faction)

            # Guard settings
            guard_widget = self.guard_widget
            guard_widget.guard_chance_spin.setValue(main_object.guard_chance)
            guard_widget.guard_value_spin.setValue(main_object.guard_value)
            guard_widget.guard_weekly_spin.setValue(main_object.guard_weekly_increment)
            guard_widget.guard_randomization_spin.setValue(main_object.guard_randomization)
            guard_widget.remove_guard_check.setChecked(main_object.remove_guard_if_has_owner)

            # Building settings
            building_widget = self.building_widget
            construction_sid = main_object.buildings_construction_sid or ""
            ban_sid = main_object.buildings_ban_sid or ""

            building_widget.set_construction_sid(construction_sid)
            building_widget.set_ban_sid(ban_sid)

            logger.debug(f"Set building settings - Construction: {construction_sid}, Ban: {ban_sid}")

            # Advanced settings
            self.enable_weekly_increment_check.setChecked(main_object.enable_weekly_unit_increment)
            self.initial_increment_spin.setValue(main_object.initial_unit_increment)

        finally:
            self._updating = False

    def get_main_object(self) -> MainObject:
        """Get the current main object."""
        if self.current_object:
            self._update_object_from_ui()
        return self.current_object

    def _reset_to_defaults(self):
        """Reset to default values."""
        default_object = MainObject()
        self.set_main_object(default_object)
        self.objectChanged.emit(default_object)

    def _validate_configuration(self):
        """Validate the current configuration."""
        if not self.current_object:
            QMessageBox.warning(self, "Validation", "No object to validate.")
            return

        try:
            self._update_object_from_ui()

            # Basic validation
            errors = []

            if self.current_object.guard_chance < 0 or self.current_object.guard_chance > 1:
                errors.append("Guard chance must be between 0.0 and 1.0")

            if self.current_object.guard_value < 0:
                errors.append("Guard value must be non-negative")

            if self.current_object.guard_randomization < 0 or self.current_object.guard_randomization > 1:
                errors.append("Guard randomization must be between 0.0 and 1.0")

            if self.current_object.initial_unit_increment < 0:
                errors.append("Initial unit increment must be non-negative")

            if errors:
                QMessageBox.warning(
                    self,
                    "Validation Errors",
                    "The following validation errors were found:\n\n" + "\n".join(f"• {error}" for error in errors),
                )
            else:
                QMessageBox.information(self, "Validation", "Configuration is valid!")

        except Exception as e:
            logger.error(f"Validation error: {e}")
            QMessageBox.critical(self, "Validation Error", f"An error occurred during validation:\n{e}")
