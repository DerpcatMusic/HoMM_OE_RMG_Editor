class ContentDatabase:
    """
    Central hub for accessing and managing all external game-related content.

    Provides unified lookup system for biomes, objects, factions, squads, and other
    game content, with caching and efficient data structures for fast access.
    """

    def __init__(self, game_data_path: str):
        """
        Initialize ContentDatabase with path to game data.

        Args:
            game_data_path: Path to HeroesOE_Data directory
        """
        self.game_data_path = Path(game_data_path)
        self.streaming_assets_path = self.game_data_path / "StreamingAssets"
        self.logger = logging.getLogger(__name__)
        core_db = self.streaming_assets_path / "Core" / "DB"
        flat_db = self.streaming_assets_path / "DB"
        if core_db.exists():
            self.core_db_path = core_db
        elif flat_db.exists():
            self.core_db_path = flat_db
        else:
            self.core_db_path = core_db
            self.logger.warning(f"DB directory not found at {core_db} or {flat_db}. Using default {core_db}.")

        # Core data structures
        self.tiles: dict[str, TileConfig] = {}
        self.objects: dict[str, ObjectConfig] = {}
        self.obj_configs: dict[str, ObjConfigBase] = {}
        self.waters: dict[str, WaterConfig] = {}
        self.factions: dict[str, FractionConfig] = {}
        self.squads: list[SquadConfig] = []

        # Generator-specific data
        self.generator_settings: GeneratorSettings | None = None
        self.encounter_templates: dict[str, EncounterTemplate] = {}
        self.zone_layouts: dict[str, ZoneLayoutConfig] = {}
        self.content_pools: dict[str, ContentPoolConfig] = {}
        self.content_lists: dict[str, ContentList] = {}

        # Meta-objects
        self.meta_objects_by_sid: dict[str, MetaObjectDesc] = {}

        # Cached lookups
        self.biome_index_by_sid: dict[str, int] = {}
        self.biome_index_by_id: dict[int, str] = {}
        self.water_id_by_biome_id: dict[int, int] = {}

        # Available content tracking
        self.available_factions: set[str] = set()
        self.biomes_info: dict[str, dict[str, Any]] = {}

        self.is_loaded = False

    def load_all_data(self) -> bool:
        """
        Load all game data from external sources.

        Returns:
            True if loading was successful, False otherwise
        """
        try:
            self.logger.info("Starting comprehensive game data loading...")

            # Load core game data (Hex.Configs equivalent)
            self._load_core_configs()

            # Load generator-specific configurations
            self._load_generator_configs()

            # Build cached lookups
            self._build_lookup_caches()

            # Post-process data
            self._organize_content_data()

            self.is_loaded = True
            self.logger.info("Game data loading completed successfully")
            return True

        except Exception as e:
            self.logger.error(f"Failed to load game data: {e}", exc_info=True)
            return False

    def _load_core_configs(self):
        """Load core game configuration data."""
        self.logger.info("Loading core game configurations...")

        # Load tile configurations (biomes)
        self._load_tile_configs()

        # Load object configurations
        self._load_object_configs()

        # Load water configurations
        self._load_water_configs()

        # Load faction configurations
        self._load_faction_configs()

        # Load squad configurations
        self._load_squad_configs()

    def _load_tile_configs(self):
        """Load biome/tile configurations."""
        tiles_file = self.core_db_path / "map_tiles.json"
        if not tiles_file.exists():
            # Try alternative locations
            alt_paths = [
                self.core_db_path / "tiles.json",
                self.streaming_assets_path / "Config" / "tiles.json",
            ]
            tiles_file = next((p for p in alt_paths if p.exists()), None)

        if tiles_file and tiles_file.exists():
            try:
                with open(tiles_file, encoding="utf-8") as f:
                    data = json.load(f)

                # Process tiles data
                tiles_list = data.get("tiles", []) if isinstance(data, dict) else data

                for i, tile_data in enumerate(tiles_list):
                    if isinstance(tile_data, dict):
                        tile = TileConfig(
                            id=tile_data.get("id", i),
                            sid=tile_data.get("sid", f"tile_{i}"),
                            name=tile_data.get("name", f"Tile {i}"),
                            description=tile_data.get("description", ""),
                            properties=tile_data.get("properties", {}),
                        )
                        self.tiles[tile.sid] = tile

                self.logger.info(f"Loaded {len(self.tiles)} tile configurations")

            except Exception as e:
                self.logger.error(f"Failed to load tiles: {e}")

    def _load_object_configs(self):
        """Load game object configurations."""
        objects_file = self.core_db_path / "objects.json"

        if objects_file.exists():
            try:
                with open(objects_file, encoding="utf-8") as f:
                    data = json.load(f)

                objects_list = data.get("objects", []) if isinstance(data, dict) else data

                for obj_data in objects_list:
                    if isinstance(obj_data, dict) and "sid" in obj_data:
                        obj = ObjectConfig(
                            sid=obj_data["sid"],
                            size_x=obj_data.get("sizeX", 1),
                            size_z=obj_data.get("sizeZ", 1),
                            pivot_x=obj_data.get("pivotX", 0),
                            pivot_z=obj_data.get("pivotZ", 0),
                            generator_config=obj_data.get("generatorConfig", {}),
                            tags=obj_data.get("tags", []),
                            interaction_layout=obj_data.get("interactionLayout", ""),
                        )
                        self.objects[obj.sid] = obj

                        # Also create basic ObjConfigBase
                        variants = []
                        variant_data = obj_data.get("variants", [])
                        for i, var in enumerate(variant_data):
                            variant = ObjVariantConfig(
                                variant_index=i,
                                roll_chance=var.get("rollChance", 1.0),
                                properties=var.get("properties", {}),
                            )
                            variants.append(variant)

                        obj_base = ObjConfigBase(
                            sid=obj_data["sid"],
